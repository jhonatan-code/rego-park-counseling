---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import { SITE, CLINICS } from '../data/site.js';
// Above-the-fold fonts, preloaded (latin subset). Two families, four weights (brand manual 12, Speed).
import nunitoWoff2 from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';
import atkinsonWoff2 from '@fontsource/atkinson-hyperlegible/files/atkinson-hyperlegible-latin-400-normal.woff2?url';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  schema?: Record<string, unknown>[]; // page nodes (no @context), merged into one @graph
  preloadImage?: string;
}
const { title, description, image = '/images/clinics/rego-park-counseling-clinic-63-36-99th-street.webp', noindex = false, breadcrumbs = [], schema = [], preloadImage } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

// Organization-level schema lives here; the home page adds the clinic nodes + FAQPage (brief, "Schema").
// name is exactly "Rego Park Counseling". No Review / AggregateRating markup.
const org = {
  '@type': 'MedicalOrganization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: `${SITE.url}/`,
  logo: `${SITE.url}/images/brand/rego-park-counseling-logo.png`,
  telephone: '+1-718-459-2558',
  department: CLINICS.filter((c) => c.status === 'open').map((c) => ({ '@id': `${SITE.url}${c.href}#clinic` })),
  // sameAs: Google profiles + social, to add once confirmed
};
const website = { '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.name, publisher: { '@id': `${SITE.url}/#organization` } };
const crumbs = breadcrumbs.length
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href })),
    }
  : null;
const jsonLd = { '@context': 'https://schema.org', '@graph': [org, website, crumbs, ...schema].filter(Boolean) };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Google Tag Manager: production host only, so local/preview visits never reach the client's GA4 or CTM -->
    <script is:inline define:vars={{ gtm: SITE.gtm }}>if (/(^|\.)regoparkcounseling\.com$/.test(location.hostname)) (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer',gtm);</script>
    <!-- End Google Tag Manager -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="theme-color" content="#0a5577" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={nunitoWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkinsonWoff2} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-screen flex-col">
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-white focus:px-5 focus:py-3 focus:font-bold focus:text-harbor">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
    <script>
      // "Request a Callback" buttons: go to this page's form if it has one, else /contact/.
      document.querySelectorAll<HTMLAnchorElement>('[data-open-callback]').forEach((a) => {
        const form = document.getElementById('callback');
        a.href = form ? '#callback' : '/contact/';
        if (form) a.addEventListener('click', () => setTimeout(() => (form.querySelector('input[name=name]') as HTMLInputElement | null)?.focus({ preventScroll: true }), 450));
      });
      // GA4 events through GTM (brief, "Tracking"): click_to_call and directions_click, with a location parameter.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLElement>('[data-cta]');
        if (!a) return;
        const w = window as unknown as { dataLayer?: Record<string, unknown>[] };
        const event = a.dataset.cta === 'directions' ? 'directions_click' : 'click_to_call';
        (w.dataLayer = w.dataLayer || []).push({ event, location: a.dataset.location || '' });
      });
    </script>
  </body>
</html>
