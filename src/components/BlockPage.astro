---
// Block-based page for Programs, Who We Serve and Therapies (brief: Service template, shorter; hubs = intro,
// cards, short FAQ, callback). Each page composes its own blocks, so pages don't look alike:
//   text (split with photo or icon) · chips (linked pills) · cards · photo-cards · steps · callout · checklist
// Backgrounds alternate automatically. Blocks/FAQs with `gate` are skipped until confirmed.
// `large` (Older Adults brief: larger type, high contrast) bumps body text one step on that page.
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import NearbyRing from './NearbyRing.astro';
import PageHero from './PageHero.astro';
import ClinicMapPanel from './ClinicMapPanel.astro';
import InsuranceLine from './InsuranceLine.astro';
import RelatedServices from './RelatedServices.astro';
import FaqList from './FaqList.astro';
import CrisisNote from './CrisisNote.astro';
import FinalCta from './FinalCta.astro';
import { SITE } from '../data/site.js';
import { clean } from '../data/mental-health.js';
import { NOT_LEGAL_ADVICE } from '../data/evaluations.js';

interface Props { page: any }
const { page } = Astro.props;
const url = `${SITE.url}${page.path}`;
const blocks = page.blocks.filter((b: any) => !b.gate);
const BG = ['', 'bg-white', 'bg-sky-wash'];
const body = page.large ? 'text-xl lg:text-[22px] leading-relaxed' : 'text-lg';
const small = page.large ? 'text-lg' : 'text-base';
const legal = page.legal ? NOT_LEGAL_ADVICE : undefined;
const faqs = page.faqs.filter((f: any) => !f.gate);
const schema = [
  page.hub
    ? { '@type': 'CollectionPage', '@id': `${url}#webpage`, url, name: page.h1, isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': `${SITE.url}/#organization` } }
    : { '@type': 'MedicalWebPage', '@id': `${url}#webpage`, url, name: page.h1, audience: { '@type': 'Patient' }, provider: { '@id': `${SITE.url}/#organization` }, isPartOf: { '@id': `${SITE.url}/#website` } },
  // FAQPage only when the page has answered questions (a page can lose all of them to the brackets plan)
  ...(faqs.length ? [{ '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: faqs.filter((f: any) => clean(f.a)).map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: clean(f.a) } })) }] : []),
];
const slug = page.path.split('/').filter(Boolean).join('-');
---
<Base title={page.title} description={page.description} breadcrumbs={page.crumbs} schema={schema}>
  <PageHero
    title={page.h1}
    sub={page.sub}
    crumbs={page.crumbs}
    trust={page.trust ?? []}
    formId={`cb-${slug}`}
    formHeading={page.formHeading ?? 'Request a Callback'}
    formLocation={slug}
    note={legal}
  />

  {blocks.map((b: any, i: number) => {
    const bg = BG[i % BG.length];
    const id = `b${i}-title`;
    const head = (
      <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <h2 id={id} class="max-w-3xl">{b.h2}</h2>
        {b.note && <p class={`${small} text-slate`}>{b.note}</p>}
      </div>
    );
    if (b.type === 'text') return (
      <section class:list={['section-y', bg]} aria-labelledby={id}>
        <div class:list={['container-x grid items-center gap-10 lg:gap-16', b.image ? 'lg:grid-cols-[1.1fr_1fr]' : 'lg:grid-cols-[auto_1fr]']}>
          {!b.image && <span class="icon-dot size-20"><Icon name={b.icon} size={40} /></span>}
          <div class:list={[b.image && i % 2 === 1 && 'lg:order-2']}>
            {b.image && <span class="icon-dot size-14"><Icon name={b.icon} size={28} /></span>}
            <h2 id={id} class:list={[b.image && 'mt-5']}>{b.h2}</h2>
            {b.text && <p class={`${body} measure mt-4 text-slate`}>{b.text}</p>}
            {b.list && (
              <ul class="mt-6 grid gap-3">
                {b.list.map((l: string) => <li class={`flex items-center gap-3 ${body}`}><span class="inline-flex size-7 flex-none items-center justify-center rounded-full bg-sky text-harbor"><Icon name="check" size={16} strokeWidth={3} /></span>{l}</li>)}
              </ul>
            )}
          </div>
          {b.image && (
            <div class="relative">
              <NearbyRing class="pointer-events-none absolute -right-14 -top-14 hidden size-[240px] lg:block" />
              <img src={b.image} alt={b.alt} width="800" height="560" loading="lazy" class="relative aspect-[4/3] w-full rounded-[var(--radius-panel)] object-cover" />
            </div>
          )}
        </div>
      </section>
    );
    if (b.type === 'chips') return (
      <section class:list={['section-y', bg]} aria-labelledby={id}>
        <div class="container-x">
          {head}
          <ul class="mt-8 flex flex-wrap gap-3">
            {b.items.map((c: any) => (
              <li>
                {c.href ? (
                  <a href={c.href} class={`group inline-flex min-h-14 items-center gap-3 rounded-full border border-sky bg-white py-2 pl-2 pr-5 font-display font-bold text-harbor transition-colors duration-200 hover:border-harbor ${body}`}>
                    <span class="icon-dot size-10"><Icon name={c.icon} size={20} /></span>{c.label}<Icon name="arrow-right" size={18} class="text-cyan transition-transform duration-200 group-hover:translate-x-1" />
                  </a>
                ) : (
                  <span class={`inline-flex min-h-14 items-center gap-3 rounded-full border border-line bg-white py-2 pl-2 pr-5 font-display font-bold text-ink ${body}`}>
                    <span class="icon-dot size-10"><Icon name={c.icon} size={20} /></span>{c.label}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    );
    if (b.type === 'cards') return (
      <section class:list={['section-y', bg]} aria-labelledby={id}>
        <div class="container-x">
          {head}
          <ul class:list={['mt-10 grid gap-5 sm:grid-cols-2', b.items.length === 3 ? 'lg:grid-cols-3' : b.items.length === 5 ? 'lg:grid-cols-5' : 'lg:grid-cols-4']}>
            {b.items.map((c: any, n: number) => (
              <li class:list={['relative flex flex-col rounded-[var(--radius-panel)] border border-line p-6', bg === 'bg-white' ? 'bg-porch' : 'bg-white', c.href && 'card-focus group transition-colors duration-200 hover:border-sky', b.size === 'lg' && 'lg:p-8']}>
                {b.numbered && <span aria-hidden="true" class="absolute right-6 top-5 font-display text-4xl font-extrabold text-sky">0{n + 1}</span>}
                <span class:list={['icon-dot', bg === 'bg-white' ? 'bg-white' : '']}><Icon name={c.icon} /></span>
                <h3 class:list={['mt-4 pr-8', b.size === 'lg' ? 'text-2xl' : 'text-xl']}>{c.href ? <a href={c.href} class="stretched-link">{c.title}</a> : c.title}</h3>
                <p class={`mt-2 flex-1 text-slate ${b.size === 'lg' ? body : small}`}>{c.text}</p>
                {c.href && <Icon name="arrow-right" size={20} class="mt-4 text-cyan transition-transform duration-200 group-hover:translate-x-1" />}
              </li>
            ))}
          </ul>
        </div>
      </section>
    );
    if (b.type === 'photo-cards') return (
      <section class:list={['section-y', bg]} aria-labelledby={id}>
        <div class="container-x">
          {head}
          <ul class="mt-10 grid gap-6 md:grid-cols-3">
            {b.items.map((c: any) => (
              <li class="card-focus group relative overflow-hidden rounded-[var(--radius-panel)] border border-line bg-white">
                {c.image ? <img src={c.image} alt={c.alt} width="800" height="560" loading="lazy" class="aspect-[16/10] w-full object-cover" /> : <div class="flex aspect-[16/10] w-full items-center justify-center bg-sky-wash" aria-hidden="true"><span class="icon-dot size-20 bg-white"><Icon name={c.icon ?? 'family'} size={40} /></span></div>}
                <div class="p-6 lg:p-7">
                  <h3 class="text-2xl"><a href={c.href} class="stretched-link">{c.title}</a></h3>
                  <p class={`mt-2 text-slate ${body}`}>{c.text}</p>
                  <span class="mt-4 inline-flex items-center gap-1.5 font-bold text-harbor">Learn more <Icon name="arrow-right" size={18} class="transition-transform duration-200 group-hover:translate-x-1" /></span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    );
    if (b.type === 'steps') return (
      <section class:list={['section-y', bg === '' ? 'bg-sand' : bg]} aria-labelledby={id}>
        <div class="container-x">
          {head}
          <ol class:list={['mt-10 grid gap-5 sm:grid-cols-2', b.items.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
            {b.items.map((s: any, n: number) => (
              <li class="flex gap-4 rounded-[var(--radius-panel)] bg-white p-5 lg:flex-col lg:p-6">
                <span class="inline-flex size-12 flex-none items-center justify-center rounded-full bg-harbor font-display text-xl font-extrabold text-white">{n + 1}</span>
                <div>
                  <h3 class="text-xl">{s.title}</h3>
                  <p class={`mt-1 text-slate ${small}`}>{s.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    );
    if (b.type === 'callout') return (
      <section class:list={['section-y', bg]} aria-labelledby={id}>
        <div class="container-x">
          <div class="relative flex flex-col gap-6 overflow-hidden rounded-[var(--radius-panel)] bg-harbor p-7 text-white lg:flex-row lg:items-center lg:justify-between lg:p-10">
            <NearbyRing class="pointer-events-none absolute hidden -bottom-40 -right-40 size-[380px] lg:block opacity-25" />
            <div class="relative max-w-3xl">
              <h2 id={id} class="!text-white">{b.h2}</h2>
              <p class={`mt-3 text-white/90 ${body}`}>{b.text}</p>
            </div>
            {b.phone && <a href={SITE.phoneHref} class="btn-call relative flex-none" data-cta="call" data-location={`${slug}-callout`}><Icon name="phone" size={20} /> {b.phone}</a>}
          </div>
        </div>
      </section>
    );
    if (b.type === 'checklist') return (
      <section class:list={['section-y', bg]} aria-labelledby={id}>
        <div class="container-x grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
          <div>
            <h2 id={id}>{b.h2}</h2>
            {b.note && <p class={`mt-3 text-slate ${small}`}>{b.note}</p>}
            {page.legal && <p class={`mt-5 flex items-start gap-2 text-slate ${small}`}><Icon name="info" size={18} class="mt-0.5 flex-none text-harbor" />{NOT_LEGAL_ADVICE}</p>}
          </div>
          <ul class="grid gap-3 sm:grid-cols-2">
            {b.items.map((t: string) => (
              <li class={`flex items-center gap-3 rounded-[var(--radius-card)] border border-line bg-white p-4 ${body}`}>
                <span class="inline-flex size-7 flex-none items-center justify-center rounded-full bg-sky text-harbor"><Icon name="check" size={16} strokeWidth={3} /></span>{t}
              </li>
            ))}
          </ul>
        </div>
      </section>
    );
    return null;
  })}

  {!page.hub && <InsuranceLine bg={page.where ? 'bg-white' : 'bg-white pt-16 lg:pt-24'} />}
  {page.related && <RelatedServices related={page.related} posts={page.posts ?? []} />}
  {/* Clinic map panel on every block page (map section, user 2026-10-02) */}
  <ClinicMapPanel title={page.where?.h2 ?? 'Find the Clinic Nearest You'} eyebrow="Where to get care" telehealth={page.where?.telehealth} />
  {faqs.length > 0 && <FaqList title={page.faqH2} faqs={page.faqs} />}
  <CrisisNote samhsa={page.path.startsWith('/programs/') || page.path.startsWith('/who-we-serve/court')} />
  <FinalCta title={page.finalH2} text="We’ll check your Medicaid plan on the call." note={legal} />
</Base>
