---
// Clinic map section (proposal B, user 2026-10-02), on ~80% of pages (not blog, posts, author/person, legal, utility):
// a clinic switcher above one panel = Google map + that clinic's details. Both panels are in the HTML (NAP for search and
// no-JS readers); the hidden clinic's map loads only when its tab is opened. Optional telehealth line and Yonkers strip.
import Icon from './Icon.astro';
import GoogleMap from './GoogleMap.astro';
import Reviews from './Reviews.astro';
import { CLINICS, fullAddress } from '../data/site.js';

interface Props {
  title?: string; eyebrow?: string; lead?: string; telehealth?: string; note?: string;
  initial?: string; yonkers?: boolean; bg?: 'white' | 'porch' | 'wash'; id?: string; bare?: boolean;
  reviews?: boolean; // Google reviews right above the map (user 2026-10-02: ~70% of pages; off on transactional pages)
}
const {
  title = 'Find the Clinic Nearest You', eyebrow = 'Our clinics', lead, telehealth, note,
  initial = 'rego-park', yonkers = false, bg = 'white', id = 'clinics-map', bare = false, reviews = true,
} = Astro.props;
const open = CLINICS.filter((c) => c.status === 'open' && c.street);
const first = open.find((c) => c.id === initial) ?? open[0];
const soon = CLINICS.find((c) => c.status === 'soon');
const bgClass = { white: 'bg-white', porch: 'bg-porch', wash: 'bg-sky-wash' }[bg];
---
{/* 6 of the 8 reviews, a stable different window per page (Sunview pattern) */}
{reviews && <Reviews limit={6} />}
<section class:list={[bare ? '' : `section-y ${bgClass}`]} aria-labelledby={`${id}-title`} data-clinic-panel>
  <div class:list={[bare ? '' : 'container-x']}>
    <div class="max-w-3xl">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`} class="mt-3">{title}</h2>
      {lead && <p class="lead mt-3">{lead}</p>}
    </div>

    <div class="mt-8 inline-flex w-full gap-1.5 rounded-full bg-sky-wash p-1.5 sm:w-auto" role="tablist" aria-label="Choose a clinic">
      {open.map((c) => (
        <button
          type="button" role="tab" id={`${id}-tab-${c.id}`} aria-controls={`${id}-panel-${c.id}`}
          aria-selected={c === first ? 'true' : 'false'} tabindex={c === first ? 0 : -1}
          class="min-h-12 flex-1 rounded-full px-5 font-display text-base font-extrabold text-harbor transition-colors duration-200 hover:bg-white/70 aria-selected:bg-white aria-selected:shadow-[0_1px_3px_rgba(7,65,91,0.18)] sm:flex-none sm:text-lg"
        >{c.name}</button>
      ))}
    </div>

    {open.map((c) => (
      <div id={`${id}-panel-${c.id}`} role="tabpanel" aria-labelledby={`${id}-tab-${c.id}`} hidden={c !== first} class="mt-4">
        <div class="grid overflow-hidden rounded-[var(--radius-panel)] border border-line bg-white lg:grid-cols-[1.5fr_1fr]">
          <div class="relative isolate h-64 bg-sky-wash sm:h-80 lg:h-auto lg:min-h-[380px]">
            <GoogleMap clinic={c} defer={c !== first} />
          </div>
          <div class="flex flex-col justify-center gap-3 border-t border-line p-6 lg:border-l lg:border-t-0 lg:p-8">
            <p class="text-sm font-bold uppercase tracking-[0.1em] text-slate">{c.label}</p>
            <h3 class="text-2xl lg:text-[28px]">{c.name}</h3>
            <address class="not-italic text-ink">{fullAddress(c)}</address>
            {c.reference && <p class="text-ink">{c.reference}</p>}
            <ul class="space-y-2 text-base">
              <li><a href={c.phoneHref} class="inline-flex items-center gap-2 font-bold text-harbor hover:underline" data-cta="call" data-location={`${id}-${c.id}`}><Icon name="phone" size={18} class="flex-none" />{c.phone}</a></li>
              <li class="flex items-start gap-2 text-slate"><Icon name="clock" size={18} class="mt-1 flex-none text-harbor" />{c.hours}</li>
            </ul>
            {note && <p class="flex items-start gap-2 text-base text-slate"><Icon name="info" size={18} class="mt-1 flex-none text-harbor" />{note}</p>}
            <div class="mt-2 flex flex-wrap gap-3">
              <a href={c.directions} target="_blank" rel="noopener" class="btn-secondary !min-h-12 !px-5 !text-base" data-cta="directions" data-location={`${id}-${c.id}`}><Icon name="navigation" size={18} /> Get directions</a>
              <a href={c.href} class="inline-flex min-h-12 items-center gap-1.5 px-2 font-bold text-harbor hover:underline">View clinic <Icon name="arrow-right" size={18} /></a>
            </div>
          </div>
        </div>
      </div>
    ))}

    {/* Two cards share the row; a single card takes the whole row (never half a row empty) */}
    {(telehealth || (yonkers && soon)) && (
      <div class:list={['mt-4 grid gap-4', telehealth && yonkers && soon && 'md:grid-cols-2']}>
        {telehealth && (
          <a href="/programs/telehealth/" class="group flex items-center gap-4 rounded-[var(--radius-card)] border border-line bg-white p-5 transition-colors duration-200 hover:border-sky">
            <span class="icon-dot flex-none"><Icon name="telehealth" /></span>
            <span class="flex-1"><span class="block font-display text-lg font-extrabold text-harbor">Telehealth</span><span class="text-slate">{telehealth}</span></span>
            <Icon name="arrow-right" size={20} class="flex-none text-harbor transition-transform duration-200 group-hover:translate-x-1" />
          </a>
        )}
        {yonkers && soon && (
          <a href={soon.href} class="group flex items-center gap-4 rounded-[var(--radius-card)] border-2 border-dashed border-sky bg-sky-wash/60 p-5 transition-colors duration-200 hover:border-harbor">
            <span class="inline-flex size-12 flex-none items-center justify-center rounded-full border-[3px] border-harbor bg-white" aria-hidden="true"></span>
            <span class="flex-1"><span class="block font-display text-lg font-extrabold text-harbor">{soon.name} · Opening soon</span><span class="text-slate">Join the list to hear when we open.</span></span>
            <Icon name="arrow-right" size={20} class="flex-none text-harbor transition-transform duration-200 group-hover:translate-x-1" />
          </a>
        )}
      </div>
    )}
  </div>
</section>

<script>
  // Accessible tabs (arrow keys, Home/End); the selected clinic's map loads on first open.
  document.querySelectorAll<HTMLElement>('[data-clinic-panel]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${x.getAttribute('aria-controls')}`);
        if (!panel) return;
        panel.hidden = !on;
        const frame = panel.querySelector<HTMLIFrameElement>('iframe[data-src]');
        if (on && frame && !frame.getAttribute('src')) frame.src = frame.dataset.src!;
      });
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        const n = k === 'ArrowRight' ? tabs[(i + 1) % tabs.length] : k === 'ArrowLeft' ? tabs[(i - 1 + tabs.length) % tabs.length] : k === 'Home' ? tabs[0] : k === 'End' ? tabs[tabs.length - 1] : null;
        if (n) { e.preventDefault(); select(n, true); }
      });
    });
  });
</script>
