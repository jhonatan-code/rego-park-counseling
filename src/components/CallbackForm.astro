---
// Callback form (brand manual 10 "Callback form"; brief sections 3 and 14).
// Four fields max: name, phone, preferred clinic, what can we help with. No email, no insurance ID,
// no health details. Posts FormData to /api/lead/ (server-side CTM proxy) with source page, form
// location and chosen clinic, then pushes dataLayer {event:'callback_submit', location}.
// A failed CTM call is never shown as success.
import Icon from './Icon.astro';
import { SITE, CLINICS } from '../data/site.js';

interface Props {
  formId: string;
  location: string; // analytics label: hero-inline, final-band, dialog…
  heading?: string;
  sub?: string;
  headingLevel?: 'h2' | 'h3' | 'p';
  compact?: boolean;
}
const { formId, location, heading = 'We’ll call you back', sub = 'Usually the same business day.', headingLevel = 'h3', compact = false } = Astro.props;
const Heading = headingLevel;
const HELP = ['Mental health', 'Substance use', 'Evaluation', 'Not sure'];
const field =
  'h-12 w-full min-w-0 rounded-[var(--radius-input)] border border-slate/40 bg-white px-4 text-[17px] text-ink placeholder:text-slate/70 focus:border-harbor focus:outline-none focus:ring-[3px] focus:ring-harbor/25';
const chip =
  'relative inline-flex min-h-12 cursor-pointer items-center rounded-full border border-slate/30 bg-white px-4 text-base font-bold text-ink transition-colors duration-200 hover:border-harbor has-[:checked]:border-harbor has-[:checked]:bg-sky has-[:checked]:text-harbor has-[:focus-visible]:outline has-[:focus-visible]:outline-[3px] has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-harbor';
---
<form class="rpc-callback" novalidate data-form-id={formId} data-location={location} action="/api/lead/" method="post">
  {heading && (
    <div class="mb-5">
      <Heading class="font-display text-2xl font-extrabold text-harbor">{heading}</Heading>
      {sub && <p class="mt-1 text-base text-slate">{sub}</p>}
    </div>
  )}

  <div class:list={['grid gap-4', !compact && 'sm:grid-cols-2']}>
    <div>
      <label for={`${formId}-name`} class="mb-1.5 block text-base font-bold text-ink">Your name</label>
      <input id={`${formId}-name`} name="name" type="text" autocomplete="given-name" required maxlength="80" class={field} aria-describedby={`${formId}-name-hint`} />
      <p id={`${formId}-name-hint`} class="mt-1 text-base text-slate">First name is fine</p>
    </div>
    <div>
      <label for={`${formId}-phone`} class="mb-1.5 block text-base font-bold text-ink">Phone number</label>
      <input id={`${formId}-phone`} name="phone" type="tel" inputmode="tel" autocomplete="tel-national" required placeholder="(718) 000-0000" class={field} />
    </div>
  </div>

  <fieldset class="mt-5">
    <legend class="mb-2 text-base font-bold text-ink">Preferred clinic</legend>
    <div class="flex flex-wrap gap-2">
      {CLINICS.map((c, i) => (
        <label class={chip}>
          <input type="radio" name="clinic" value={c.name} class="sr-only" checked={i === 0} />
          {c.name}{c.status === 'soon' && <span class="ml-1 font-normal text-slate">(soon)</span>}
        </label>
      ))}
    </div>
  </fieldset>

  <fieldset class="mt-5">
    <legend class="mb-2 text-base font-bold text-ink">What can we help with?</legend>
    <div class="flex flex-wrap gap-2">
      {HELP.map((h) => (
        <label class={chip}>
          <input type="radio" name="help_with" value={h} class="sr-only" checked={h === 'Not sure'} />
          {h}
        </label>
      ))}
    </div>
  </fieldset>

  {/* Honeypot */}
  <div class="absolute -left-[9999px]" aria-hidden="true">
    <label>Leave empty <input type="text" name="hp_field" tabindex="-1" autocomplete="off" /></label>
  </div>

  <p class="rpc-error mt-4 hidden rounded-[var(--radius-input)] bg-attention/10 px-4 py-3 text-base font-bold text-attention" role="alert"></p>

  <button type="submit" class="btn-call mt-6 w-full sm:w-auto" data-location={location}>
    <Icon name="callback" size={20} />
    <span class="rpc-label">Request a callback</span>
  </button>
  <p class="mt-3 flex items-start gap-2 text-base text-slate">
    <Icon name="lock" size={18} class="mt-0.5 flex-none text-harbor" />
    <span>Your information is private. By sending, you agree we may call or text you at this number. Prefer to talk now? Call <a href={SITE.phoneHref} class="font-bold text-harbor underline underline-offset-2" data-cta="call" data-location={location}>{SITE.phone}</a>.</span>
  </p>
</form>

<div class="rpc-success hidden rounded-[var(--radius-card)] border border-success/30 bg-success/5 p-6" role="status" tabindex="-1" data-for={formId}>
  <p class="font-display text-2xl font-extrabold text-success">Thank you. We’ll call you soon.</p>
  <p class="mt-2 text-slate">A counselor from our team will call the number you gave us, usually the same business day. If you’d rather not wait, call <a href={SITE.phoneHref} class="font-bold text-harbor underline" data-cta="call" data-location={location}>{SITE.phone}</a>.</p>
</div>

<script>
  // Wires every callback form on the page once (the component can appear more than once).
  const w = window as unknown as { dataLayer?: Record<string, unknown>[]; __rpcForms?: boolean };
  if (!w.__rpcForms) {
    w.__rpcForms = true;
    const digits = (v: string) => v.replace(/\D/g, '');
    document.querySelectorAll<HTMLFormElement>('form.rpc-callback').forEach((form) => {
      const err = form.querySelector<HTMLElement>('.rpc-error')!;
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      const label = btn.querySelector<HTMLElement>('.rpc-label')!;
      const success = document.querySelector<HTMLElement>(`.rpc-success[data-for="${form.dataset.formId}"]`);
      const fail = (msg: string, field?: HTMLInputElement | null) => {
        err.textContent = msg;
        err.classList.remove('hidden');
        field?.setAttribute('aria-invalid', 'true');
        field?.focus();
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        err.classList.add('hidden');
        form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
        const name = form.elements.namedItem('name') as HTMLInputElement;
        const phone = form.elements.namedItem('phone') as HTMLInputElement;
        if (name.value.trim().length < 2) return fail('Please tell us your name.', name);
        const d = digits(phone.value);
        if (d.length < 10 || d.length > 11) return fail('Please enter a 10-digit phone number.', phone);

        const fd = new FormData(form);
        fd.set('page', location.pathname);
        fd.set('form_location', form.dataset.location || '');
        const url = new URL(location.href);
        const gclid = url.searchParams.get('gclid') || (document.cookie.match(/_gcl_aw=[^;]*\.([^.;]+)/)?.[1] ?? '');
        if (gclid) fd.set('attribution[gclid]', gclid);
        const ctm = (window as unknown as { __ctm?: { config?: { sid?: string } } }).__ctm;
        if (ctm?.config?.sid) fd.set('visitor_sid', ctm.config.sid);

        btn.disabled = true;
        label.textContent = 'Sending…';
        try {
          const res = await fetch('/api/lead/', { method: 'POST', body: fd });
          const data = await res.json().catch(() => ({}));
          if (!res.ok || !data.ok) throw new Error(data.error || 'We couldn’t send your request.');
          (w.dataLayer = w.dataLayer || []).push({
            event: 'callback_submit',
            location: String(fd.get('clinic') || ''),
            form_location: form.dataset.location,
          });
          form.classList.add('hidden');
          success?.classList.remove('hidden');
          success?.focus();
        } catch (ex) {
          fail(`${(ex as Error).message} Please call us instead.`);
        } finally {
          btn.disabled = false;
          label.textContent = 'Request a callback';
        }
      });
    });
  }
</script>
