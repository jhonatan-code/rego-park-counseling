---
// Callback card. Layout mirrors the approved Sunview hero card (compact white card: title row, two-column
// fields, one full-width button, small reassurance lines under it); colors, type and radii follow the RPC
// brand manual (magenta = callback action, Harbor focus ring, 16px floor, 8px inputs).
// Four fields max (brand manual 10): name, phone, preferred clinic, what can we help with. No email,
// no insurance ID, no health details. Posts FormData to /api/lead/ (server-side CTM proxy) with source page,
// form location and chosen clinic, then pushes dataLayer {event:'callback_submit', location}.
// A failed CTM call is never shown as success.
import Icon from './Icon.astro';
import { SITE, CLINICS } from '../data/site.js';

interface Props {
  formId: string;
  location: string; // analytics label
  heading?: string;
}
const { formId, location, heading = 'Request a Callback' } = Astro.props;
const HELP = ['Mental health', 'Substance use', 'Evaluation', 'Not sure yet'];
const lbl = 'mb-1.5 block text-base leading-snug text-slate';
const field =
  'h-12 w-full min-w-0 rounded-[var(--radius-input)] border border-slate/40 bg-white px-3.5 text-[17px] text-ink focus:border-harbor focus:outline-none focus:ring-[3px] focus:ring-harbor/25 aria-[invalid=true]:border-attention';
const chevron = 'pointer-events-none absolute right-3.5 top-1/2 -translate-y-1/2 text-slate';
---
<form
  class="rpc-callback w-full rounded-[var(--radius-panel)] bg-white p-5 text-ink shadow-[0_2px_6px_rgba(0,0,0,0.14),0_24px_48px_rgba(7,65,91,0.28)] sm:p-7"
  novalidate
  data-form-id={formId}
  data-location={location}
  action="/api/lead/"
  method="post"
>
  <div class="mb-5 flex items-center gap-3">
    <span class="icon-dot"><Icon name="callback" /></span>
    <p class="font-display text-xl font-extrabold leading-tight text-harbor sm:text-[22px]">{heading}</p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <label class={lbl} for={`${formId}-name`}>Your name <span aria-hidden="true" class="text-attention">*</span></label>
      <input id={`${formId}-name`} class={field} type="text" name="name" autocomplete="given-name" required maxlength="80" />
    </div>
    <div>
      <label class={lbl} for={`${formId}-phone`}>Phone number <span aria-hidden="true" class="text-attention">*</span></label>
      <input id={`${formId}-phone`} class={field} type="tel" name="phone" autocomplete="tel-national" inputmode="tel" required />
    </div>
    <div>
      <label class={lbl} for={`${formId}-clinic`}>Preferred clinic</label>
      <div class="relative">
        <select id={`${formId}-clinic`} name="clinic" class:list={[field, 'appearance-none pr-10']}>
          {CLINICS.map((c) => <option value={c.name}>{c.name}{c.status === 'soon' ? ' (opening soon)' : ''}</option>)}
        </select>
        <Icon name="chevron-down" size={18} class={chevron} />
      </div>
    </div>
    <div>
      <label class={lbl} for={`${formId}-help`}>What can we help with?</label>
      <div class="relative">
        <select id={`${formId}-help`} name="help_with" class:list={[field, 'appearance-none pr-10']}>
          {HELP.map((h) => <option value={h === 'Not sure yet' ? 'Not sure' : h}>{h}</option>)}
        </select>
        <Icon name="chevron-down" size={18} class={chevron} />
      </div>
    </div>

    {/* Honeypot: hidden from people and autofill */}
    <div class="hidden" aria-hidden="true">
      <label>Leave this empty <input type="text" name="hp_field" tabindex="-1" autocomplete="off" /></label>
    </div>

    <button type="submit" class="btn-call w-full sm:col-span-2">
      <span class="rpc-label">Request a Callback</span>
    </button>
    <p class="rpc-msg -mt-1 text-center text-base font-bold text-attention sm:col-span-2" role="alert" hidden></p>
  </div>

  <p class="mt-4 text-center text-base leading-relaxed text-slate">
    Or call us at <a href={SITE.phoneHref} class="font-bold text-harbor" data-cta="call" data-location={location}>{SITE.phone}</a>. Your information is private.
  </p>
  <p class="mt-1 text-center text-base leading-relaxed text-slate">
    By submitting, you agree we may call or text you, and to our <a href="/privacy-policy/" class="underline underline-offset-2">Privacy Policy</a>.
  </p>
</form>

<script>
  const MIN_FILL_MS = 1200; // bots submit instantly; real autofill takes longer
  document.querySelectorAll<HTMLFormElement>('form.rpc-callback').forEach((form) => {
    const started = Date.now();
    const msg = form.querySelector<HTMLElement>('.rpc-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const label = btn.querySelector<HTMLElement>('.rpc-label')!;
    const show = (text: string, ok = false) => {
      msg.hidden = false;
      msg.textContent = text;
      msg.classList.toggle('text-attention', !ok);
      msg.classList.toggle('text-success', ok);
    };
    form.querySelectorAll('input').forEach((el) =>
      el.addEventListener('input', () => { el.removeAttribute('aria-invalid'); if (!form.querySelector('[aria-invalid=true]')) msg.hidden = true; }),
    );

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = form.elements.namedItem('name') as HTMLInputElement;
      const phone = form.elements.namedItem('phone') as HTMLInputElement;
      const digits = phone.value.replace(/\D/g, '').replace(/^1(?=\d{10}$)/, '');
      const badName = name.value.trim().length < 2;
      const badPhone = digits.length !== 10;
      name.setAttribute('aria-invalid', String(badName));
      phone.setAttribute('aria-invalid', String(badPhone));
      if (badName || badPhone) {
        (badName ? name : phone).focus();
        return show(badName ? 'Please tell us your name.' : 'Please enter a 10-digit phone number.');
      }
      if (Date.now() - started < MIN_FILL_MS) return show('One moment, then try again.');

      const fd = new FormData(form);
      fd.set('page', location.pathname);
      fd.set('form_location', form.dataset.location || '');
      const gclid = new URL(location.href).searchParams.get('gclid') || (document.cookie.match(/_gcl_aw=[^;]*\.([^.;]+)/)?.[1] ?? '');
      if (gclid) fd.set('attribution[gclid]', gclid);
      const sid = (window as any).__ctm?.config?.sid;
      if (sid) fd.set('visitor_sid', sid);

      btn.disabled = true;
      label.textContent = 'Sending…';
      try {
        const res = await fetch('/api/lead/', { method: 'POST', body: fd });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || 'We couldn’t send your request.');
        const w = window as any;
        (w.dataLayer = w.dataLayer || []).push({ event: 'callback_submit', location: String(fd.get('clinic') || ''), form_location: form.dataset.location });
        form.reset();
        show('Thank you. We’ll call you back soon, usually the same business day.', true);
      } catch (err) {
        show(`${(err as Error).message} Please call us at (718) 459-2558.`);
      } finally {
        btn.disabled = false;
        label.textContent = 'Request a Callback';
      }
    });
  });
</script>
