---
// Google reviews carousel, ported verbatim from the approved Sunview design (user, 2026-10-02: "exactamente igual"): white section, centered H2, Google Reviews
// wordmark + 5 stars, then a carousel showing 4.1 cards on desktop / 2.1 on tablet / 1.1 on mobile, arrows on
// the sides (outside the cards, so they never cover text), and "Read our reviews on Google" below. Cards
// mirror Google's review UI: name, then the star rating (no relative date, QA batch 1 item 3).
// Text is verbatim, 5 stars only, first name + last initial; each card caps text at 5 lines and the
// rest scrolls inside the card (touch/wheel/keyboard) or opens with "More". No reviewer photos,
// no review or rating schema anywhere on the site. Data: src/data/reviews.js.
// Latin subset only (English reviews): the full imports pulled every subset's @font-face into a render-blocking CSS file.
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import { reviewsByDate, GBP_URL } from '../data/reviews.js';
// `limit` (QA batch 2, item 12): category and program pages (ServicePage) show 6 of the 11 reviews, a window
// that starts at an index derived from the page path, so each page gets a stable, different set (same set on
// every build). Home and Our Team pass no limit and show all 11. No schema here, and no AggregateRating on any
// page: Google reviews are third-party, and self-serving rating markup breaks Google's review-snippet rules.
interface Props { title?: string; id?: string; limit?: number; seed?: string }
const { title = 'What People Say About Rego Park Counseling', id = 'reviews', limit, seed = Astro.url.pathname } = Astro.props;
const hash = (s: string) => [...s].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
const reviews = limit && limit < reviewsByDate.length
  ? Array.from({ length: limit }, (_, k) => reviewsByDate[(hash(seed) + k) % reviewsByDate.length])
  : reviewsByDate;

// Google-style avatar colors, picked per initial
const COLORS = ['#1a73e8', '#e8710a', '#188038', '#d93025', '#9334e6', '#12b5cb', '#c5221f', '#b06000'];
const color = (s: string) => COLORS[s.charCodeAt(0) % COLORS.length];
---
<section class="section-y bg-white" aria-labelledby={`${id}-title`}>
  <div class="container-x">
    <div class="text-center">
      <h2 id={`${id}-title`} class="text-3xl sm:text-[2.1875rem]">{title}</h2>
      <img src="/images/badges/google-reviews.svg" alt="Google Reviews" width="93" height="33" class="mx-auto mt-5 h-12 w-auto" />
      <p class="mt-2 flex justify-center gap-1 text-[#fbbc04]" role="img" aria-label="5-star reviews">
        {Array.from({ length: 5 }).map(() => (
          <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true"><path fill="currentColor" d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg>
        ))}
      </p>
    </div>

    <div class="sv-reviews relative mt-10 md:px-14" data-carousel>
      <button type="button" class="sv-rv-arrow absolute left-0 top-1/2 z-10 hidden -translate-y-1/2 md:inline-flex" data-dir="-1" aria-label="Previous reviews" aria-controls={`${id}-track`}>
        <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path d="m15 18-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <ul id={`${id}-track`} class="sv-rv-track" aria-label="Google reviews">
        {reviews.map((r, i) => (
          <li class="sv-rv-card">
            <article class="flex h-full flex-col gap-2.5 sv-rv-box rounded-[12px] border border-[#dadce0] bg-white p-[18px] text-[#202124]" aria-label={`Review by ${r.author}`}>
              <div class="flex items-center gap-3">
                <span class="grid h-10 w-10 flex-none place-items-center rounded-full text-lg font-medium text-white" style={`background:${color(r.author)}`} aria-hidden="true">{r.author.charAt(0)}</span>
                <div>
                  <p class="text-[15px] font-medium leading-tight">{r.author}</p>
                  <p class="mt-1 flex gap-px text-[#fbbc04]" role="img" aria-label={`${r.rating} out of 5 stars`}>
                    {Array.from({ length: r.rating }).map(() => (
                      <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true"><path fill="currentColor" d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg>
                    ))}
                  </p>
                </div>
                <svg viewBox="0 0 48 48" class="ml-auto h-5 w-5 flex-none" role="img" aria-label="Google">
                  <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3c-1.6 4.7-6.1 8-11.3 8-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" />
                  <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
                  <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
                  <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" />
                </svg>
              </div>
              <p class="sv-rv-text" id={`${id}-t${i}`} tabindex="0">{r.text}</p>
              <button type="button" class="sv-rv-more self-start text-sm font-medium text-[#1a73e8]" aria-controls={`${id}-t${i}`} aria-expanded="false" hidden>More</button>
            </article>
          </li>
        ))}
      </ul>
      <button type="button" class="sv-rv-arrow absolute right-0 top-1/2 z-10 hidden -translate-y-1/2 md:inline-flex" data-dir="1" aria-label="Next reviews" aria-controls={`${id}-track`}>
        <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true"><path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>

    <div class="mt-8 text-center">
      <a href={GBP_URL} target="_blank" rel="noopener" class="btn-secondary">Read our reviews on Google</a>
    </div>
  </div>
</section>

<style is:global>
  /* 1.1 cards on mobile, 2.1 on tablet, 3.1 on small laptops, 4.1 on desktop; swipe with scroll-snap */
  /* Padding left and bottom leaves room for each card's soft shadow inside the scroll box */
  .sv-rv-track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px 4px 22px 12px; scroll-padding-left: 12px; scrollbar-width: none; overscroll-behavior-x: contain; list-style: none; margin: 0; }
  .sv-rv-track::-webkit-scrollbar { display: none; }
  .sv-rv-card { scroll-snap-align: start; flex: 0 0 calc((100% - 16px) / 1.1); }
  @media (min-width: 768px) { .sv-rv-card { flex-basis: calc((100% - 2 * 16px) / 2.1); } }
  @media (min-width: 1024px) { .sv-rv-card { flex-basis: calc((100% - 3 * 16px) / 3.1); } }
  @media (min-width: 1280px) { .sv-rv-card { flex-basis: calc((100% - 4 * 16px) / 4.1); } }
  .sv-rv-box { box-shadow: -5px 6px 14px -4px rgba(60, 64, 67, .18); font-family: Arial, sans-serif; }
  /* Roboto only once the carousel is near the viewport (CWV round 2): browsers fetch a web font only when some
     rendered text uses it, so the two Roboto files no longer compete with the hero on the critical path. */
  .sv-reviews.sv-rv-fonts .sv-rv-box { font-family: Roboto, Arial, sans-serif; }
  /* 5-line text box: the rest scrolls inside the card, or opens with "More" */
  .sv-rv-text { font-size: 14px; line-height: 1.4; max-height: calc(1.4em * 5); overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; padding-right: 6px; scrollbar-width: thin; }
  .sv-rv-text.is-long { -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 1.6em), transparent); mask-image: linear-gradient(to bottom, #000 calc(100% - 1.6em), transparent); }
  .sv-rv-text.at-end, .sv-rv-text.expanded { -webkit-mask-image: none; mask-image: none; }
  .sv-rv-text.expanded { max-height: none; overflow: visible; }
  .sv-rv-text:focus-visible { outline: 2px solid #1a73e8; outline-offset: 2px; border-radius: 4px; }
  .sv-rv-arrow { width: 44px; height: 44px; border-radius: 9999px; align-items: center; justify-content: center; background: #fff; border: 1px solid #dadce0; color: #202124; box-shadow: 0 1px 3px rgba(60, 64, 67, .2), 0 4px 10px rgba(60, 64, 67, .12); cursor: pointer; }
  .sv-rv-arrow:hover { background: #f8f9fa; }
  .sv-rv-arrow:disabled { opacity: .35; cursor: default; }
</style>

<script>
  // Layout reads are batched before the writes (CWV round 2: the old per-card loop read scrollHeight right after
  // toggling a class on the previous card, forcing a reflow per card), and nothing is measured at parse time: the
  // first measure runs after the first frame, and again once Roboto (switched on when the carousel nears the
  // viewport) has loaded.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.sv-rv-track')!;
    const arrows = root.querySelectorAll<HTMLButtonElement>('.sv-rv-arrow');
    const texts = [...root.querySelectorAll<HTMLElement>('.sv-rv-text')];
    const mores = texts.map((t) => root.querySelector<HTMLButtonElement>(`.sv-rv-more[aria-controls="${t.id}"]`)!);
    const step = () => (track.firstElementChild?.getBoundingClientRect().width ?? 320) + 16;
    const sync = () => {
      const { scrollLeft, clientWidth, scrollWidth } = track;
      arrows[0].disabled = scrollLeft <= 2;
      arrows[1].disabled = scrollLeft + clientWidth >= scrollWidth - 2;
    };
    // Read every card's overflow first, then write the classes and "More" buttons
    const measure = () => {
      const long = texts.map((t) => !t.classList.contains('expanded') && t.scrollHeight > t.clientHeight + 2);
      sync();
      texts.forEach((t, i) => {
        if (t.classList.contains('expanded')) return;
        t.classList.toggle('is-long', long[i]);
        mores[i].hidden = !long[i];
      });
    };
    arrows.forEach((b) => b.addEventListener('click', () => track.scrollBy({ left: step() * Number(b.dataset.dir), behavior: 'smooth' })));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);

    texts.forEach((t, i) => {
      const more = mores[i];
      t.addEventListener('scroll', () => t.classList.toggle('at-end', t.scrollTop + t.clientHeight >= t.scrollHeight - 2), { passive: true });
      more.addEventListener('click', () => {
        const open = t.classList.toggle('expanded');
        more.textContent = open ? 'Less' : 'More';
        more.setAttribute('aria-expanded', String(open));
      });
    });

    // rAF + setTimeout = right after the next frame's layout, so the reads find a clean layout and force none
    const later = () => requestAnimationFrame(() => setTimeout(measure));
    later(); // first pass at load (fallback font), so "More" is in place long before the reviews are reached
    const start = () => {
      root.classList.add('sv-rv-fonts');
      document.fonts?.load('14px Roboto').then(later, later);
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) { io.disconnect(); start(); }
      }, { rootMargin: '800px 0px' });
      io.observe(root);
    } else start();
  });
</script>
