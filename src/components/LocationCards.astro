---
// "Where to get care" block for service pages: Rego Park + Fresh Meadows cards and a telehealth card.
// NAP comes from site.js so it matches the footer and the Google profiles.
import Icon from './Icon.astro';
import NearbyRing from './NearbyRing.astro';
import { CLINICS } from '../data/site.js';

interface Props { title: string; telehealth: string; eyebrow?: string; fmLabel?: string; id?: string }
const { title, telehealth, eyebrow = 'Where to get care', fmLabel, id = 'where-title' } = Astro.props;
const open = CLINICS.filter((c) => c.status === 'open');
---
<section class="section-y bg-white" aria-labelledby={id}>
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={id} class="mt-3">{title}</h2>
    </div>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {open.map((c) => (
        <article class="flex flex-col overflow-hidden rounded-[var(--radius-panel)] border border-line bg-white" aria-labelledby={`${id}-${c.id}`}>
          {c.image ? (
            <img src={c.image} alt={c.imageAlt} width="640" height="420" loading="lazy" class="aspect-[16/8] w-full object-cover" />
          ) : (
            <div class="relative flex aspect-[16/8] w-full items-center justify-center overflow-hidden bg-sky-wash">
              <NearbyRing class="absolute size-[320px]" />
              <span class="relative rounded-full bg-white px-4 py-2 font-display font-extrabold text-harbor shadow">{c.name}</span>
            </div>
          )}
          <div class="flex flex-1 flex-col p-6">
            <p class="text-sm font-bold uppercase tracking-[0.1em] text-slate">{c.id === 'fresh-meadows' && fmLabel ? fmLabel : c.label}</p>
            <h3 id={`${id}-${c.id}`} class="mt-1">{c.name}</h3>
            <address class="mt-3 space-y-2 not-italic">
              <span class="flex items-start gap-2"><Icon name="pin" size={20} class="mt-0.5 flex-none text-harbor" />{c.street}, {c.city}, {c.region} {c.postal}</span>
              <a href={c.phoneHref} class="flex items-center gap-2 font-bold text-harbor hover:underline" data-cta="call" data-location={c.id}><Icon name="phone" size={20} class="flex-none" />{c.phone}</a>
              <span class="flex items-start gap-2 text-slate"><Icon name="clock" size={20} class="mt-0.5 flex-none text-harbor" />{c.hours ?? 'Hours coming soon. Call us to book.'}</span>
            </address>
            <div class="mt-auto flex flex-wrap gap-3 pt-6">
              <a href={c.directions} target="_blank" rel="noopener" class="btn-secondary !min-h-11 !px-4 !text-base" data-cta="directions" data-location={c.id}><Icon name="navigation" size={18} /> Get directions</a>
              <a href={c.href} class="inline-flex min-h-11 items-center gap-1.5 px-2 font-bold text-harbor hover:underline">View clinic <Icon name="arrow-right" size={18} /></a>
            </div>
          </div>
        </article>
      ))}
      <div class="card-focus relative flex flex-col justify-between overflow-hidden rounded-[var(--radius-panel)] bg-harbor p-7 text-white">
        <NearbyRing class="pointer-events-none absolute hidden -bottom-28 -right-28 size-[300px] lg:block opacity-30" />
        <div class="relative">
          <span class="inline-flex size-12 items-center justify-center rounded-full bg-white/10 text-sky"><Icon name="telehealth" /></span>
          <h3 class="mt-5 !text-white">Telehealth</h3>
          <p class="mt-2 text-lg text-white/90">{telehealth}</p>
        </div>
        <a href="/programs/telehealth/" class="stretched-link relative mt-6 inline-flex items-center gap-1.5 font-bold text-white">How telehealth works <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </div>
</section>
