---
// Conditions block (proposal A, user 2026-10-02): area tabs + icon cards. Used on Home (two areas → tabs) and on the
// Mental Health and Substance Use hubs (one area → no tabs, same cards). Every card's link is in the HTML (hidden tab
// included) so all internal links stay crawlable. Optional default slot below the cards (call line, dual-diagnosis bar).
import Icon from './Icon.astro';

interface Item { label: string; text: string; href: string; icon: string }
interface Group { key: string; label: string; icon: string; items: Item[] }
interface Props { id: string; eyebrow: string; title: string; lead?: string; groups: Group[]; bg?: 'white' | 'wash'; headingLevel?: 'h3' | 'h2' }
const { id, eyebrow, title, lead, groups, bg = 'wash' } = Astro.props;
const tabs = groups.length > 1;
// wash = Sky Wash → white gradient (user 2026-10-02, separates it from the next band); cards get a soft border so the
// lower ones still read against white
const card = bg === 'wash' ? 'bg-white !border-sky/70' : 'bg-porch border-line';
---
<section class:list={['section-y', bg === 'wash' ? 'bg-linear-to-b from-sky-wash to-white' : 'bg-white']} aria-labelledby={`${id}-title`} data-condition-tabs>
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-title`} class="mt-3">{title}</h2>
      {lead && <p class="lead mt-3">{lead}</p>}
    </div>

    {tabs && (
      <div class:list={['mt-8 inline-flex w-full gap-1.5 rounded-full p-1.5 sm:w-auto', bg === 'wash' ? 'bg-white' : 'bg-sky-wash']} role="tablist" aria-label="Areas of care">
        {groups.map((g, i) => (
          <button
            type="button" role="tab" id={`${id}-tab-${g.key}`} aria-controls={`${id}-panel-${g.key}`}
            aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
            class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-full px-4 font-display text-[15px] font-extrabold text-harbor transition-colors duration-200 hover:bg-sky-wash aria-selected:bg-harbor aria-selected:text-white sm:flex-none sm:px-5 sm:text-base"
          ><Icon name={g.icon as any} size={20} class="hidden flex-none sm:block" />{g.label}</button>
        ))}
      </div>
    )}

    {groups.map((g, i) => (
      <div id={`${id}-panel-${g.key}`} role={tabs ? 'tabpanel' : undefined} aria-labelledby={tabs ? `${id}-tab-${g.key}` : undefined} hidden={tabs && i > 0} class:list={[tabs ? 'mt-5' : 'mt-10']}>
        <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {g.items.map((c) => (
            <li class:list={['card-focus group relative flex items-start gap-4 rounded-[var(--radius-card)] border border-transparent p-5 transition-colors duration-200 hover:!border-sky', card]}>
              <span class:list={['icon-dot flex-none', bg === 'wash' ? '' : 'bg-white']}><Icon name={c.icon as any} /></span>
              <div class="min-w-0 flex-1">
                <h3 class="text-lg leading-snug lg:text-xl"><a href={c.href} class="stretched-link">{c.label}</a></h3>
                <p class="mt-1 text-base leading-snug text-slate">{c.text}</p>
              </div>
              <Icon name="arrow-right" size={20} class="mt-3 flex-none text-cyan transition-transform duration-200 group-hover:translate-x-1" />
            </li>
          ))}
        </ul>
      </div>
    ))}

    <slot />
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-condition-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    if (!tabs.length) return;
    const select = (t: HTMLButtonElement, focus = false) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${x.getAttribute('aria-controls')}`);
        if (panel) panel.hidden = !on;
      });
      if (focus) t.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key;
        const n = k === 'ArrowRight' ? tabs[(i + 1) % tabs.length] : k === 'ArrowLeft' ? tabs[(i - 1 + tabs.length) % tabs.length] : k === 'Home' ? tabs[0] : k === 'End' ? tabs[tabs.length - 1] : null;
        if (n) { e.preventDefault(); select(n, true); }
      });
    });
  });
</script>
