---
// "Request a Callback" from the header or the mobile bar opens this native <dialog> on every page,
// so the visitor never loses their place. Without JS the buttons fall back to /contact/.
import CallbackForm from './CallbackForm.astro';
import Icon from './Icon.astro';
---
<dialog id="callback-dialog" class="m-auto w-[min(560px,calc(100vw-24px))] max-h-[calc(100dvh-24px)] overflow-y-auto rounded-[var(--radius-panel)] border-0 bg-white p-0 text-ink shadow-2xl backdrop:bg-ink/55" aria-labelledby="callback-dialog-title">
  <div class="relative p-6 sm:p-8">
    <button type="button" class="absolute right-3 top-3 inline-flex size-12 items-center justify-center rounded-full text-harbor hover:bg-sky-wash" aria-label="Close" data-close-callback>
      <Icon name="x" size={24} />
    </button>
    <p class="eyebrow">Talk to someone today</p>
    <h2 id="callback-dialog-title" class="mt-2 pr-10 text-2xl lg:text-[28px]">We’ll call you back</h2>
    <p class="mt-1 text-slate">Usually the same business day. We’ll check your Medicaid plan on the call.</p>
    <div class="mt-6">
      <CallbackForm formId="cb-dialog" location="dialog" heading="" compact />
    </div>
  </div>
</dialog>

<script>
  const dlg = document.getElementById('callback-dialog') as HTMLDialogElement | null;
  document.querySelectorAll<HTMLElement>('[data-open-callback]').forEach((b) =>
    b.addEventListener('click', (e) => {
      if (!dlg?.showModal) return; // very old browsers: let the link fall through
      e.preventDefault();
      dlg.showModal();
      (dlg.querySelector('input[name=name]') as HTMLInputElement | null)?.focus();
    }),
  );
  dlg?.querySelector('[data-close-callback]')?.addEventListener('click', () => dlg.close());
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); }); // backdrop click
</script>
