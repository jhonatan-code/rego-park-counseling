---
// Footer (brief, "Footer"; brand manual 10 "Footer"). Mid-size layout ("Propuesta A", 2026-10-02):
// brand row (logo, line, phone, social) → clinic cards (the NAP that must match each Google Business
// Profile exactly) + three short link groups → licensing, brand-separation line and legal links.
// Link groups collapse to tap-to-open sections below lg (open by default without JS).
// No Nearby Ring here: the FinalCta band right above already carries the one ring per screen.
import Icon from './Icon.astro';
import { SITE, CLINICS, LEGAL, SOCIAL } from '../data/site.js';

const groups = [
  {
    title: 'Care',
    links: [
      { label: 'Mental Health', href: '/mental-health/' },
      { label: 'Anxiety Counseling', href: '/mental-health/anxiety-counseling/' },
      { label: 'Depression Counseling', href: '/mental-health/depression-counseling/' },
      { label: 'Substance Use', href: '/substance-use/' },
      { label: 'Dual Diagnosis', href: '/substance-use/dual-diagnosis/' },
    ],
  },
  {
    title: 'Programs',
    links: [
      { label: 'Evaluations', href: '/evaluations/' },
      { label: 'CORE (HARP)', href: '/programs/core/' },
      { label: 'Telehealth', href: '/programs/telehealth/' },
      { label: 'Therapies', href: '/therapies/' },
      { label: 'Older Adults', href: '/who-we-serve/older-adults/' },
    ],
  },
  {
    title: 'Rego Park Counseling',
    links: [
      { label: 'About Us', href: '/about/' },
      { label: 'Insurance', href: '/insurance/' },
      { label: 'Locations', href: '/locations/' },
      { label: 'Blog', href: '/blog/' },
      { label: 'Contact Us', href: '/contact/' },
    ],
  },
];
const open = CLINICS.filter((c) => c.status !== 'soon');
const soon = CLINICS.filter((c) => c.status === 'soon');
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-harbor text-white">
  <div class="container-x pt-12 lg:pt-14">

    {/* Brand row */}
    <div class="flex flex-col gap-6 border-b border-white/15 pb-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex flex-col gap-3">
        {/* White one-color logo straight on Harbor (client-supplied version, 2026-10-02) instead of the white plate */}
        <a href="/" class="inline-flex min-h-12 shrink-0 items-center self-start" aria-label="Rego Park Counseling, home">
          <img src="/images/brand/rego-park-counseling-logo-white.webp" alt="Rego Park Counseling" width="560" height="153" loading="lazy" class="h-auto w-[280px] lg:w-[300px]" />
        </a>
        <p class="max-w-[46ch] text-base leading-relaxed text-white/85">
          Licensed outpatient counseling for mental health and substance use, close to home in Queens.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <div>
          <a href={SITE.phoneHref} class="inline-flex min-h-12 items-center gap-2 font-display text-2xl font-extrabold text-white hover:text-sky" data-cta="call" data-location="footer">
            <Icon name="phone" size={24} class="text-sky" /> {SITE.phone}
          </a>
          <p class="text-sm text-white/75">Fax {SITE.fax}</p>
        </div>
        {SOCIAL.length > 0 && (
          <ul class="flex items-center gap-2" aria-label="Follow Rego Park Counseling">
            {SOCIAL.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener" class="inline-flex size-12 items-center justify-center rounded-full border border-white/25 text-white transition-colors duration-200 hover:bg-white/10" aria-label={`Rego Park Counseling on ${s.label} (opens in a new tab)`}>
                  <Icon name={s.icon} size={22} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </div>

    <div class="grid gap-8 pt-8 lg:grid-cols-[1.15fr_1.15fr_1fr_1fr_1fr] lg:gap-6">

      {/* Clinic cards */}
      <ul class="grid gap-3.5 sm:grid-cols-2 lg:col-span-2 lg:self-start">
        {open.map((c) => (
          <li class="rounded-[var(--radius-card)] border border-white/15 bg-white/[0.06] p-4 lg:p-5">
            <p class="text-xs font-bold uppercase tracking-[0.1em] text-sky">{c.label}</p>
            <a href={c.href} class="font-display text-lg font-extrabold text-white hover:underline">{c.name}</a>
            <address class="mt-1.5 flex gap-2 text-[15px] not-italic leading-snug text-white/85">
              <Icon name="pin" size={16} class="mt-0.5 shrink-0 text-sky" />
              <span>{c.street}, {c.city}, {c.region} {c.postal}</span>
            </address>
            {c.hours && (
              <p class="mt-1.5 flex gap-2 text-[15px] leading-snug text-white/85">
                <Icon name="clock" size={16} class="mt-0.5 shrink-0 text-sky" />
                <span>{c.hours}</span>
              </p>
            )}
            {c.directions && (
              <a href={c.directions} class="mt-1 inline-flex min-h-11 items-center gap-1.5 text-[15px] font-bold text-sky hover:underline" target="_blank" rel="noopener" data-cta="directions" data-location={c.id}>
                <Icon name="navigation" size={15} /> Get directions
              </a>
            )}
          </li>
        ))}
        {soon.map((c) => (
          <li class="flex flex-wrap items-center justify-between gap-2 rounded-[var(--radius-card)] border border-dashed border-white/25 px-4 py-3 sm:col-span-2 lg:px-5">
            <span>
              <span class="block text-xs font-bold uppercase tracking-[0.1em] text-sky">{c.label}</span>
              <a href={c.href} class="font-display text-lg font-extrabold text-white hover:underline">{c.name}</a>
            </span>
            <a href={c.href} class="inline-flex min-h-11 items-center gap-1 text-[15px] font-bold text-sky hover:underline">Join the list <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>

      {/* Short link groups; tap-to-open below lg */}
      <nav aria-label="Footer" class="lg:col-span-3 lg:grid lg:grid-cols-3 lg:gap-6">
        {groups.map((g) => (
          <details class="footer-group border-t border-white/15 lg:border-0" open>
            <summary class="flex min-h-13 cursor-pointer list-none items-center justify-between font-display text-lg font-extrabold text-white lg:pointer-events-none lg:mb-2 lg:min-h-0 [&::-webkit-details-marker]:hidden">
              {g.title}
              <Icon name="plus" size={22} class="footer-plus text-sky transition-transform duration-200 lg:hidden" />
            </summary>
            <ul class="pb-3 lg:pb-0">
              {g.links.map((l) => (
                <li><a href={l.href} class="tap-target text-base leading-snug text-white/85 hover:text-white hover:underline">{l.label}</a></li>
              ))}
            </ul>
          </details>
        ))}
      </nav>
    </div>
  </div>

  {/* Licensing, separation line, legal */}
  <div class="relative mt-10 bg-harbor-deep pb-28 lg:mt-12 lg:pb-0">
    <div class="container-x flex flex-col gap-3 py-5 text-[15px] text-white/85 lg:flex-row lg:items-center lg:justify-between">
      <div class="space-y-1">
        <p><strong class="text-white">{SITE.independentLine}</strong> Licensed by the New York State Office of Addiction Services and Supports (OASAS) and the Office of Mental Health (OMH).</p>
        <p>© {year} Rego Park Counseling. Outpatient care only.</p>
      </div>
      <ul class="flex flex-wrap gap-x-5">
        {LEGAL.map((l) => (
          <li><a href={l.href} class="tap-target hover:text-white hover:underline">{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer-group[open] :global(.footer-plus) { transform: rotate(45deg); }
</style>

<script>
  // Below lg the link groups start closed (tap to open); at lg+ they are always open.
  const mq = window.matchMedia('(min-width: 1024px)');
  const sync = () => document.querySelectorAll<HTMLDetailsElement>('.footer-group').forEach((d) => { d.open = mq.matches; });
  sync();
  mq.addEventListener('change', sync);
</script>
