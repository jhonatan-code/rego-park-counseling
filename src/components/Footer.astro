---
// Footer (brief, "Footer"; brand manual 10 "Footer"). Repeats the key links for crawling and trust.
// One block per clinic = the NAP that must match each Google Business Profile exactly.
// Link columns: Mental Health, Substance Use, Evaluations, Programs, plus About/Insurance/Blog/Contact.
// Licensing line, legal links, and the brand-separation line vs the similarly named center.
import Icon from './Icon.astro';
import NearbyRing from './NearbyRing.astro';
import { SITE, NAV, CLINICS, LEGAL, live } from '../data/site.js';

const byLabel = (l: string) => NAV.find((n) => n.label === l)!;
const programLinks = byLabel('Programs').columns!.flatMap((c) => live(c.links));
const cols = [
  { title: 'Mental Health', href: '/mental-health/', links: live(byLabel('Mental Health').links) },
  { title: 'Substance Use', href: '/substance-use/', links: live(byLabel('Substance Use').links).filter((l) => l.href !== '/substance-use/') },
  { title: 'Evaluations', href: '/evaluations/', links: live(byLabel('Evaluations').links) },
  { title: 'Programs', href: '/programs/', links: programLinks },
  {
    title: 'Rego Park Counseling',
    href: '/about/',
    links: [
      { label: 'About Us', href: '/about/' },
      { label: 'Our Team', href: '/about/our-team/' },
      { label: 'Insurance', href: '/insurance/' },
      { label: 'Locations', href: '/locations/' },
      { label: 'Blog', href: '/blog/' },
      { label: 'Contact', href: '/contact/' },
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-harbor text-white">

  {/* Clinics + NAP */}
  <div class="container-x relative pt-14 lg:pt-20">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_2fr]">
      <div>
        {/* Logo always on a white plate on dark grounds (brand manual 02) */}
        <a href="/" class="inline-block rounded-[var(--radius-card)] bg-white px-5 py-4" aria-label="Rego Park Counseling, home">
          <img src="/images/brand/rego-park-counseling-logo.png" alt="Rego Park Counseling" width="347" height="75" loading="lazy" class="h-auto w-[220px]" />
        </a>
        <p class="mt-6 max-w-sm text-lg leading-relaxed text-white/90">
          Licensed outpatient counseling for mental health and substance use, close to home in Queens.
        </p>
        <a href={SITE.phoneHref} class="mt-5 inline-flex items-center gap-2 font-display text-2xl font-extrabold text-white hover:text-sky" data-cta="call" data-location="footer">
          <Icon name="phone" size={24} class="text-sky" /> {SITE.phone}
        </a>
        <p class="mt-1 text-base text-white/75">Fax {SITE.fax}</p>
      </div>

      <ul class="grid gap-4 sm:grid-cols-3">
        {CLINICS.map((c) => (
          <li class="rounded-[var(--radius-card)] border border-white/15 bg-white/[0.06] p-5">
            <p class="text-sm font-bold uppercase tracking-[0.1em] text-sky">{c.label}</p>
            <a href={c.href} class="mt-1 block font-display text-xl font-extrabold text-white hover:underline">{c.name}</a>
            {c.street ? (
              <address class="mt-2 text-base not-italic leading-snug text-white/90">
                {c.street}<br />{c.city}, {c.region} {c.postal}
              </address>
            ) : (
              <p class="mt-2 text-base leading-snug text-white/80">Address and opening date coming soon.</p>
            )}
            <a href={c.phoneHref} class="mt-2 block text-base font-bold text-white hover:underline" data-cta="call" data-location={`footer-${c.id}`}>{c.phone}</a>
            {/* Hours pending from Emmanuel: shown once confirmed */}
            {c.hours && <p class="mt-1 text-base text-white/80">{c.hours}</p>}
            {c.directions && (
              <a href={c.directions} class="mt-3 inline-flex items-center gap-1.5 text-base font-bold text-sky hover:underline" target="_blank" rel="noopener" data-cta="directions" data-location={c.id}>
                <Icon name="navigation" size={16} /> Get directions
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </div>

  {/* Link columns */}
  <div class="container-x relative mt-12 border-t border-white/15 pt-10 lg:mt-16">
    <nav aria-label="Footer" class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-3 lg:grid-cols-5">
      {cols.map((col) => (
        <div>
          <a href={col.href} class="font-display text-lg font-extrabold text-white hover:underline">{col.title}</a>
          <ul class="mt-3 space-y-2">
            {col.links.map((l) => (
              <li><a href={l.href} class="text-base text-white/85 hover:text-white hover:underline">{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  {/* Licensing, separation line, legal */}
  <div class="relative mt-12 bg-harbor-deep pb-28 lg:pb-0">
    <div class="container-x flex flex-col gap-4 py-6 text-base text-white/85 lg:flex-row lg:items-center lg:justify-between">
      <div class="space-y-1">
        <p><strong class="text-white">{SITE.independentLine}</strong> Licensed by the New York State Office of Addiction Services and Supports (OASAS) and the Office of Mental Health (OMH).</p>
        <p>© {year} Rego Park Counseling. Outpatient care only.</p>
      </div>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {LEGAL.map((l) => (
          <li><a href={l.href} class="hover:text-white hover:underline">{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
