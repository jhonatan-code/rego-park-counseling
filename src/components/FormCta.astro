---
// Closing band WITH the callback form, for pages whose brief repeats the form at the end as a reminder (Home: "Full
// callback form + phone, repeated"; About: "One sentence + callback form + phone"). Other inner pages keep FinalCta
// (no second form); Our Team stays form-light by the user's call (2026-09-30).
// Sand band: heading, one sentence, the phone, optional crisis line on the left; the shared CallbackForm on the right.
// One Nearby Ring cropped off the bottom-right edge, behind the card, never behind text.
import Icon from './Icon.astro';
import NearbyRing from './NearbyRing.astro';
import CallbackForm from './CallbackForm.astro';
import { SITE } from '../data/site.js';

interface Props { title: string; text: string; formId: string; location: string; button?: string; crisis?: boolean; eyebrow?: string }
const { title, text, formId, location, button, crisis = false, eyebrow } = Astro.props;
---
<section class="relative overflow-hidden bg-sand" aria-labelledby={`${formId}-title`}>
  <NearbyRing class="pointer-events-none absolute -bottom-56 -right-40 hidden size-[600px] lg:block" />
  <div class="container-x relative grid items-center gap-10 py-16 lg:grid-cols-[1fr_500px] lg:gap-16 lg:py-24">
    <div>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={`${formId}-title`} class="mt-3 lg:!text-[44px] lg:leading-[1.1]">{title}</h2>
      <p class="lead measure mt-4">{text}</p>
      <a href={SITE.phoneHref} class="group mt-8 inline-flex items-center gap-3 font-display text-2xl font-extrabold text-harbor" data-cta="call" data-location={location}>
        <span class="inline-flex size-12 items-center justify-center rounded-full bg-white text-harbor transition-colors duration-200 group-hover:bg-sky-wash"><Icon name="phone" size={22} /></span>
        <span><span class="block font-sans text-base font-normal text-slate">Prefer to talk now?</span>Call {SITE.phone}</span>
      </a>
      {crisis && (
        <p class="measure mt-8 flex items-start gap-2 text-base text-ink">
          <Icon name="info" size={18} class="mt-1 flex-none text-harbor" />
          <span>If you are in danger, call <a href="tel:911" class="font-bold text-harbor underline">911</a>. For a mental health or substance use crisis, call or text <a href="tel:988" class="font-bold text-harbor underline">988</a>, available 24/7.</span>
        </p>
      )}
      <p class="measure mt-4 text-base text-slate">{SITE.independentLine}</p>
    </div>
    <div class="flex justify-center lg:justify-end">
      <CallbackForm formId={formId} location={location} heading="Request a Callback" button={button} />
    </div>
  </div>
</section>
