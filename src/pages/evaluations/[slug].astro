---
// Substance Abuse Evaluation + DWI Evaluation (Evaluations Pages Content brief, §2–3). Rhythm differs from the
// Mental Health template: definition panel / when-list → vertical 5-step timeline → "if treatment" band →
// why (DWI) → where + cost → learn more → FAQ → final band. The banner form books the evaluation
// (form_location "evaluation-<slug>" tells CTM it's an evaluation lead).
// Never promise a result or that a court/DMV/employer accepts the report. DWI: not-legal-advice line in the
// hero, in the "when" section and in the final band.
// Schema: MedicalWebPage + Service (serviceType, provider, areaServed Queens/NYC) + FAQPage + BreadcrumbList.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import NearbyRing from '../../components/NearbyRing.astro';
import PageHero from '../../components/PageHero.astro';
import FaqList from '../../components/FaqList.astro';
import FinalCta from '../../components/FinalCta.astro';
import { SITE, CLINICS, fullAddress } from '../../data/site.js';
import { EVALS, EVAL_POSTS, COST, NOT_LEGAL_ADVICE } from '../../data/evaluations.js';
import { clean } from '../../data/mental-health.js';

export function getStaticPaths() {
  return EVALS.map((e) => ({ params: { slug: e.slug }, props: { page: e } }));
}
const { page } = Astro.props as { page: any };
const url = `${SITE.url}/evaluations/${page.slug}/`;
const crumbs = [{ name: 'Evaluations', href: '/evaluations/' }, { name: page.crumb, href: `/evaluations/${page.slug}/` }];
const rp = CLINICS.find((c) => c.id === 'rego-park')!;
const faqForSchema = page.faqs.filter((f: any) => !f.gate && clean(f.a).length > 0);
const schema = [
  { '@type': 'MedicalWebPage', '@id': `${url}#webpage`, url, name: page.h1, audience: { '@type': 'Patient' }, provider: { '@id': `${SITE.url}/#organization` }, isPartOf: { '@id': `${SITE.url}/#website` } },
  {
    '@type': 'Service',
    '@id': `${url}#service`,
    name: page.crumb,
    serviceType: page.serviceType,
    provider: { '@id': `${SITE.url}/#organization` },
    areaServed: [{ '@type': 'City', name: 'Queens, NY' }, { '@type': 'City', name: 'New York, NY' }],
    availableChannel: { '@type': 'ServiceChannel', serviceLocation: { '@id': `${SITE.url}${rp.href}#clinic` } },
  },
  { '@type': 'FAQPage', '@id': `${url}#faq`, mainEntity: faqForSchema.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: clean(f.a) } })) },
];
const legal = page.legal ? NOT_LEGAL_ADVICE : undefined;
---
<Base title={page.title} description={page.description} breadcrumbs={crumbs} schema={schema}>
  <PageHero
    title={page.h1}
    sub={page.sub}
    crumbs={crumbs}
    trust={page.trust}
    formId={`cb-${page.slug}`}
    formHeading={page.formHeading}
    formButton="Book My Evaluation"
    formLocation={`evaluation-${page.slug}`}
    note={legal}
  />

  {/* What it is (Substance Abuse) */}
  {page.what && (
    <section class="section-y" aria-labelledby="what-title">
      <div class="container-x grid items-center gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
        <div>
          <span class="icon-dot size-14"><Icon name="clipboard" size={28} /></span>
          <h2 id="what-title" class="mt-5">{page.what.h2}</h2>
        </div>
        <div>
          <p class="lead">{page.what.text}</p>
          <p class="mt-6 rounded-[var(--radius-panel)] border-l-[6px] border-harbor bg-white p-5 font-display text-2xl font-extrabold text-harbor lg:p-6">{page.what.pull}</p>
        </div>
      </div>
    </section>
  )}

  {/* Who needs one (Substance Abuse) */}
  {page.who && (
    <section class="section-y bg-white" aria-labelledby="who-title">
      <div class="container-x">
        <h2 id="who-title" class="max-w-3xl">{page.who.h2}</h2>
        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {page.who.items.map((w: any) => (
            <li class:list={['flex flex-col rounded-[var(--radius-panel)] border border-line bg-porch p-5', w.link && 'card-focus relative']}>
              <span class="icon-dot bg-white"><Icon name={w.icon} /></span>
              <h3 class="mt-4 text-lg">{w.link ? <a href={w.link.href} class="stretched-link">{w.title}</a> : w.title}</h3>
              <p class="mt-1 text-base text-slate">{w.text}</p>
              {w.link && <span class="mt-auto inline-flex items-center gap-1 pt-3 text-base font-bold text-harbor">{w.link.label} <Icon name="arrow-right" size={16} /></span>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* When you need one (DWI) */}
  {page.when && (
    <section class="section-y" aria-labelledby="when-title">
      <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.25fr] lg:gap-16">
        <div>
          <span class="icon-dot size-14"><Icon name="car" size={28} /></span>
          <h2 id="when-title" class="mt-5">{page.when.h2}</h2>
          <p class="lead mt-4">{page.when.intro}</p>
        </div>
        <div>
          <ul class="grid gap-3">
            {page.when.items.filter((i: any) => !i.gate).map((i: any) => (
              <li class="flex items-start gap-4 rounded-[var(--radius-card)] border border-line bg-white p-4 lg:p-5">
                <span class="mt-0.5 inline-flex size-7 flex-none items-center justify-center rounded-full bg-sky text-harbor"><Icon name="check" size={16} strokeWidth={3} /></span>
                <span class="text-lg">{i.text}</span>
              </li>
            ))}
          </ul>
          <p class="mt-5 flex items-start gap-3 rounded-[var(--radius-card)] bg-sand p-4"><Icon name="clipboard" size={20} class="mt-0.5 flex-none text-harbor" />{page.when.outro}</p>
          <p class="mt-4 flex items-start gap-2 text-base text-slate"><Icon name="info" size={18} class="mt-0.5 flex-none text-harbor" />{NOT_LEGAL_ADVICE}</p>
        </div>
      </div>
    </section>
  )}

  {/* What happens — vertical timeline */}
  <section class="section-y bg-sky-wash" aria-labelledby="steps-title">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">Step by step</p>
        <h2 id="steps-title" class="mt-3">{page.stepsH2}</h2>
        <a href={SITE.phoneHref} class="btn-call mt-8" data-cta="call" data-location={`${page.slug}-steps`}><Icon name="phone" size={20} /> Call with your deadline</a>
      </div>
      <ol class="relative space-y-4 before:absolute before:bottom-8 before:left-[27px] before:top-8 before:w-0.5 before:bg-harbor/20">
        {page.steps.map((s: any, i: number) => (
          <li class="relative flex gap-5">
            <span class="relative z-[1] inline-flex size-14 flex-none items-center justify-center rounded-full bg-harbor font-display text-xl font-extrabold text-white ring-8 ring-sky-wash">{i + 1}</span>
            <div class="flex-1 rounded-[var(--radius-panel)] bg-white p-5">
              <h3 class="text-xl">{s.title}</h3>
              <p class="mt-1 text-slate">{s.text}</p>
              {s.link && <a href={s.link.href} class="text-link mt-2 inline-block text-base">{s.link.label}</a>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* If treatment is recommended */}
  <section class="relative overflow-hidden bg-harbor text-white" aria-labelledby="after-title">
    <NearbyRing class="pointer-events-none absolute -right-40 -top-48 size-[520px] opacity-25" />
    <div class="container-x relative flex flex-col gap-6 py-14 lg:flex-row lg:items-center lg:justify-between lg:py-16">
      <div class="max-w-2xl">
        <h2 id="after-title" class="!text-white">{page.after.h2}</h2>
        <p class="mt-3 text-lg text-white/90">{page.after.text}</p>
      </div>
      <a href={page.after.link.href} class="btn-on-dark flex-none">{page.after.link.label} <Icon name="arrow-right" size={18} /></a>
    </div>
  </section>

  {/* Why us (DWI) */}
  {page.why && (
    <section class="section-y" aria-labelledby="why-title">
      <div class="container-x">
        <h2 id="why-title" class="max-w-3xl">{page.why.h2}</h2>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {page.why.items.map((w: any) => (
            <li class="rounded-[var(--radius-panel)] border-t-4 border-harbor bg-white p-6">
              <span class="icon-dot"><Icon name={w.icon} /></span>
              <p class="mt-4 text-lg font-bold text-ink">{w.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Where + cost */}
  <section class="section-y bg-white" aria-labelledby="where-title">
    <div class="container-x">
      <h2 id="where-title">{page.whereH2}</h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-[1.3fr_1fr]">
        <article class="grid overflow-hidden rounded-[var(--radius-panel)] border border-line sm:grid-cols-[0.9fr_1fr]">
          <img src={rp.image} alt={rp.imageAlt} width="640" height="420" loading="lazy" class="h-full min-h-[220px] w-full object-cover" />
          <div class="flex flex-col p-6">
            <p class="text-sm font-bold uppercase tracking-[0.1em] text-slate">Main evaluations site</p>
            <h3 class="mt-1 text-2xl">Rego Park</h3>
            <address class="mt-3 space-y-2 not-italic">
              <span class="flex items-start gap-2"><Icon name="pin" size={20} class="mt-0.5 flex-none text-harbor" />{fullAddress(rp)}</span>
              <a href={rp.phoneHref} class="flex items-center gap-2 font-bold text-harbor hover:underline" data-cta="call" data-location={`${page.slug}-where`}><Icon name="phone" size={20} class="flex-none" />{rp.phone}</a>
              <span class="flex items-start gap-2 text-slate"><Icon name="clock" size={20} class="mt-0.5 flex-none text-harbor" />{rp.hours ?? 'Hours: [confirm]'}</span>
            </address>
            <div class="mt-auto flex flex-wrap gap-3 pt-5">
              <a href={rp.directions} target="_blank" rel="noopener" class="btn-secondary !min-h-11 !px-4 !text-base" data-cta="directions" data-location="rego-park"><Icon name="navigation" size={18} /> Get Directions</a>
              <a href={rp.href} class="inline-flex min-h-11 items-center gap-1.5 px-2 font-bold text-harbor hover:underline">View Clinic <Icon name="arrow-right" size={18} /></a>
            </div>
            <p class="mt-4 text-base text-slate">Fresh Meadows: [confirm whether evaluations are offered there]</p>
          </div>
        </article>
        <div class="rounded-[var(--radius-panel)] bg-sand p-6 lg:p-7">
          <h3 class="text-2xl">Cost and payment</h3>
          <dl class="mt-5 space-y-4">
            {COST.map((c) => (
              <div class="flex gap-3">
                <dt class="flex items-start gap-3"><span class="icon-dot size-10 bg-white"><Icon name={c.icon as any} size={20} /></span></dt>
                <dd><span class="block font-bold text-harbor">{c.label}</span><span class="text-slate">{c.text}</span></dd>
              </div>
            ))}
          </dl>
          <a href={SITE.phoneHref} class="btn-call mt-6" data-cta="call" data-location={`${page.slug}-cost`}><Icon name="phone" size={20} /> Ask about pricing</a>
        </div>
      </div>
    </div>
  </section>

  {/* Learn more */}
  <section class="pb-16 lg:pb-24 bg-white" aria-labelledby="learn-title">
    <div class="container-x">
      <div class="rounded-[var(--radius-panel)] bg-sky-wash p-6 lg:p-8">
        <h2 id="learn-title" class="text-2xl lg:text-[28px]">Learn More</h2>
        <ul class:list={['mt-5 grid gap-3', page.posts.length > 2 ? 'md:grid-cols-2' : 'md:grid-cols-2']}>
          {page.posts.map((k: string) => (
            <li><a href={EVAL_POSTS[k].href} class="group flex h-full items-start gap-3 rounded-[var(--radius-card)] bg-white p-4 font-bold text-harbor"><Icon name="book" size={20} class="mt-0.5 flex-none text-cyan" /><span class="group-hover:underline">{EVAL_POSTS[k].title}</span></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <FaqList title={page.faqH2} faqs={page.faqs} lead="Deadline coming up? Call us with your paperwork and we’ll explain what we can provide." />

  <FinalCta title={page.finalH2} text="Tell us who requested the evaluation and when it is due." note={legal} secondary="Book an Evaluation" />
</Base>
