---
// Yonkers (Locations Pages Content brief, §4): live from launch as a short "opening soon" page so Google indexes
// it early. No clinic schema until the address and opening date are confirmed. The banner form is the waitlist
// (form_location "yonkers-waitlist" tells CTM the source). Grows into a full clinic page at opening:
// address, phone, hours, photos, team, transit (Metro-North/bus), neighborhoods, MedicalClinic schema, local FAQ,
// map, Google profile linked; title and H1 lose "Opening Soon".
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import NearbyRing from '../../components/NearbyRing.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE, CLINICS } from '../../data/site.js';
import { YONKERS } from '../../data/locations.js';
import MobileFormSection from '../../components/MobileFormSection.astro';
import ClinicMapPanel from '../../components/ClinicMapPanel.astro';

const crumbs = [{ name: 'Locations', href: '/locations/' }, { name: 'Yonkers', href: '/locations/yonkers/' }];
const queens = CLINICS.filter((c) => c.status === 'open');
---
<Base title={YONKERS.title} description={YONKERS.description} breadcrumbs={crumbs}>
  <PageHero title={YONKERS.h1} sub={YONKERS.sub} eyebrow="Opening soon" crumbs={crumbs} formId="yonkers-waitlist" formHeading="Get Notified When We Open" formLocation="yonkers-waitlist" formButton="Notify Me When You Open" formClinic="Yonkers" formInline>
    <div slot="extra" class="mt-8 flex items-center gap-4">
      <span class="inline-flex size-14 flex-none items-center justify-center rounded-full border-[3px] border-sky bg-transparent" aria-hidden="true"></span>
      <p class="text-lg text-white/90">Leave your number in the form and we’ll call you as soon as the Yonkers clinic opens.</p>
    </div>
  </PageHero>

  {/* Planned services list removed until confirmed (BRACKETS-FILL-PLAN 1.8) */}

  <ClinicMapPanel reviews={false} id="open-now" eyebrow="Open now" title="Our Queens Clinics Are Open" lead="You don’t have to wait for Yonkers. Visit us in Rego Park or Fresh Meadows, or meet by telehealth." telehealth="Meet with a licensed counselor by secure video." />

  {/* Mobile: the waitlist form (not in the banner below 1024px) */}
  <MobileFormSection />

  {/* Until we open */}
  <section class="section-y relative overflow-hidden bg-sand" aria-labelledby="before-title">
    <NearbyRing class="pointer-events-none absolute hidden -bottom-52 -right-40 size-[560px] lg:block" />
    <div class="container-x relative grid items-center gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <div>
        <h2 id="before-title">{YONKERS.beforeH2}</h2>
        <p class="lead measure mt-4">{YONKERS.beforeText}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={SITE.phoneHref} class="btn-call" data-cta="call" data-location="yonkers-before"><Icon name="phone" size={20} /> Call {SITE.phone}</a>
          <a href="/programs/telehealth/" class="btn-secondary"><Icon name="telehealth" size={20} /> Explore Telehealth</a>
        </div>
      </div>
      <ul class="grid gap-3">
        {queens.map((c) => (
          <li class="card-focus relative flex items-center justify-between gap-4 rounded-[var(--radius-card)] bg-white p-5">
            <div>
              <p class="text-sm font-bold uppercase tracking-[0.1em] text-slate">Open now</p>
              <a href={c.href} class="stretched-link font-display text-xl font-extrabold text-harbor">{c.name}</a>
              <p class="text-base text-slate">{c.street}, {c.city}</p>
            </div>
            <Icon name="arrow-right" size={22} class="flex-none text-cyan" />
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
