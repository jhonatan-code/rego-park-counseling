---
// Clinic pages (Locations Pages Content brief): the website twin of each Google Business Profile.
// Location template: 1 hero (address block + form) · 2 real photos (if any) · 3 services (hub links: which services run
// at which clinic is unconfirmed, BRACKETS-FILL-PLAN 1.6) · 4 getting here + map · 5 neighborhoods · (FM: languages,
// gated) · 7 insurance · 8 local FAQ · (team block removed until real staff: plan 2.1) ·
// 9 brand separation (Rego Park) · 10 final band. Each page carries its own services mix, transit,
// neighborhoods and FAQ (no city-swapped copy). Fresh Meadows leads with mental health (priority clinic).
// NAP from site.js only. Yonkers has its own page (opening soon).
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import NearbyRing from '../../components/NearbyRing.astro';
import PageHero from '../../components/PageHero.astro';
import GoogleMap from '../../components/GoogleMap.astro';
import InsuranceLine from '../../components/InsuranceLine.astro';
import FaqList from '../../components/FaqList.astro';
import FinalCta from '../../components/FinalCta.astro';
import { SITE, CLINICS, fullAddress } from '../../data/site.js';
import { CLINIC_PAGES } from '../../data/locations.js';
import { clean } from '../../data/mental-health.js';

export function getStaticPaths() {
  return Object.keys(CLINIC_PAGES).map((id) => ({ params: { clinic: id } }));
}
const id = Astro.params.clinic as 'rego-park' | 'fresh-meadows';
const page: any = CLINIC_PAGES[id];
const c = CLINICS.find((x) => x.id === id)!;
const url = `${SITE.url}${c.href}`;
const crumbs = [{ name: 'Locations', href: '/locations/' }, { name: c.name, href: c.href }];
// Main service hubs, linked from every clinic page (which services run at which clinic: PENDING 1.11)
const HUBS = [
  { label: 'Mental Health Counseling', text: 'Anxiety, depression, trauma and more.', href: '/mental-health/', icon: 'brain' },
  { label: 'Outpatient Substance Use Treatment', text: 'Counseling for alcohol and drug use.', href: '/substance-use/', icon: 'sprout' },
  { label: 'Evaluations', text: 'Substance abuse and DWI evaluations.', href: '/evaluations/', icon: 'clipboard' },
  { label: 'Therapies', text: 'Individual, group and family therapy.', href: '/therapies/', icon: 'users' },
  { label: 'Programs', text: 'CORE, Social Care Network and telehealth.', href: '/programs/', icon: 'core' },
];
const photos = (page.photos ?? []).filter((p: any) => p.src); // real photos only, never placeholders (plan 1.9)

const schema = [
  {
    '@type': 'MedicalClinic',
    '@id': `${url}#clinic`,
    name: `${SITE.name} – ${c.name}`,
    url,
    telephone: '+1-718-459-2558', // [confirm with Oriana which number goes in schema once CTM pools exist]
    address: { '@type': 'PostalAddress', streetAddress: c.street, addressLocality: c.city, addressRegion: c.region, postalCode: c.postal, addressCountry: 'US' },
    geo: { '@type': 'GeoCoordinates', latitude: c.geo.lat, longitude: c.geo.lng },
    hasMap: c.directions,
    medicalSpecialty: page.specialty,
    // availableService omitted until the services at each clinic are confirmed (PENDING 1.11)
    parentOrganization: { '@id': `${SITE.url}/#organization` },
    // Only confirmed hours (site.js CLINICS.openingHours): Rego Park and Fresh Meadows confirmed; Yonkers pending
    ...(c.openingHours ? { openingHoursSpecification: c.openingHours.map((h: any) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens: h.opens, closes: h.closes })) } : {}),
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: page.faqs.filter((f: any) => clean(f.a)).map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: clean(f.a) } })),
  },
];
---
<Base title={page.title} description={page.description} breadcrumbs={crumbs} schema={schema} image={c.image ?? undefined}>
  {/* 1 · Hero with the address block */}
  <PageHero title={page.h1} sub={page.sub} crumbs={crumbs} formId={`cb-${id}`}>
    <div slot="extra" class="mt-8 max-w-xl rounded-[var(--radius-panel)] border border-white/15 bg-white/[0.07] p-5 lg:p-6">
      <p class="font-display text-lg font-extrabold text-white">{SITE.name} — {c.name}</p>
      <ul class="mt-3 space-y-2 text-white/90">
        <li class="flex items-start gap-3"><Icon name="pin" size={20} class="mt-0.5 flex-none text-sky" /><address class="not-italic">{fullAddress(c)}</address></li>
        <li class="flex items-center gap-3"><Icon name="phone" size={20} class="flex-none text-sky" /><a href={c.phoneHref} class="font-bold text-white hover:underline" data-cta="call" data-location={`hero-${id}`}>{c.phone}</a></li>
        <li class="flex items-start gap-3"><Icon name="clock" size={20} class="mt-0.5 flex-none text-sky" />{c.hours ?? 'Call for hours.'}</li>
      </ul>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={c.directions} target="_blank" rel="noopener" class="btn-on-dark" data-cta="directions" data-location={id}><Icon name="navigation" size={18} /> Get Directions</a>
        <a href={c.phoneHref} class="btn-call" data-cta="call" data-location={`hero-${id}`}><Icon name="phone" size={18} /> Call</a>
      </div>
    </div>
  </PageHero>

  {/* 2 · Real photos of this clinic only (none → no strip; Fresh Meadows uses the map below) */}
  {photos.length > 0 && (
    <section class="bg-porch pt-10 lg:pt-14" aria-label={`Photos of our ${c.name} clinic`}>
      <div class="container-x">
        <ul class:list={['grid gap-3 lg:gap-4', photos.length > 1 ? 'grid-cols-2 lg:grid-cols-4' : 'grid-cols-1']}>
          {photos.map((p: any) => (
            <li class:list={['relative overflow-hidden rounded-[var(--radius-card)] bg-sky-wash', photos.length > 1 ? 'aspect-[4/3]' : 'aspect-[16/9] lg:aspect-[21/8]']}>
              <img src={p.src} alt={p.alt} width="960" height="720" loading="lazy" class="h-full w-full object-cover" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* 3 · Services: the main hubs (which run at this clinic is asked on the call) */}
  <section class="section-y" aria-labelledby="services-title">
    <div class="container-x">
      <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <h2 id="services-title">{page.servicesH2 ?? `Services at Our ${c.name} Clinic`}</h2>
        <p class="text-base text-slate">Ask us which services are available at this clinic.</p>
      </div>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {HUBS.map((s) => (
          <li class="card-focus group relative flex flex-col gap-3 rounded-[var(--radius-card)] border border-line bg-white p-5 transition-colors duration-200 hover:border-sky">
            <span class="icon-dot"><Icon name={s.icon as any} /></span>
            <div>
              <h3 class="text-lg"><a href={s.href} class="stretched-link">{s.label}</a></h3>
              <p class="mt-1 text-base text-slate">{s.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 4 · Getting here + map */}
  <section class="section-y bg-white" aria-labelledby="getting-title">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-12">
      <div>
        <p class="eyebrow">Getting here</p>
        <h2 id="getting-title" class="mt-3">{page.gettingH2}</h2>
        <dl class="mt-8 divide-y divide-line border-y border-line">
          {page.getting.map((g: any) => (
            <div class="flex gap-4 py-4">
              <dt class="flex w-40 flex-none items-center gap-3 font-display font-bold text-harbor"><span class="icon-dot size-10"><Icon name={g.icon} size={20} /></span>{g.label}</dt>
              <dd class="self-center text-slate">{g.text}</dd>
            </div>
          ))}
        </dl>
        <a href={c.directions} target="_blank" rel="noopener" class="btn-secondary mt-8" data-cta="directions" data-location={`${id}-getting`}><Icon name="navigation" size={18} /> Get Directions</a>
      </div>
      <div class="h-[380px] overflow-hidden rounded-[var(--radius-panel)] border border-line bg-sky-wash"><GoogleMap clinic={c} /></div>
    </div>
  </section>

  {/* 5 · Neighborhoods */}
  <section class="section-y relative overflow-hidden bg-sand" aria-labelledby="hoods-title">
    <NearbyRing class="pointer-events-none absolute hidden -bottom-48 -right-40 size-[520px] lg:block" />
    <div class="container-x relative grid items-center gap-8 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <div>
        <h2 id="hoods-title">{page.hoodsH2}</h2>
        <p class="lead measure mt-4">{page.hoodsText}</p>
      </div>
      <ul class="flex flex-wrap gap-2.5" aria-label="Neighborhoods">
        {page.hoods.map((h: string, i: number) => (
          <li class:list={['rounded-full px-4 py-2 font-display font-bold', i === 0 ? 'bg-harbor text-white' : 'border border-sky bg-white text-harbor']}>{h}</li>
        ))}
      </ul>
    </div>
  </section>

  {/* Languages (Fresh Meadows) — only once the team's languages are confirmed */}
  {page.languages && !page.languages.gate && (
    <section class="section-y" aria-labelledby="lang-title">
      <div class="container-x">
        <h2 id="lang-title">{page.languages.h2}</h2>
        <ul class="mt-6 flex flex-wrap gap-3">{page.languages.list.map((l: string) => <li class="rounded-full bg-sky-wash px-5 py-2.5 font-bold text-harbor">{l}</li>)}</ul>
      </div>
    </section>
  )}

  {/* 7 · Insurance */}
  <InsuranceLine text="Call and we’ll check yours before your first visit." bg="bg-porch" />

  {/* 8 · Local FAQ */}
  <FaqList title={page.faqH2} faqs={page.faqs} lead={`Questions about our ${c.name} clinic? Call us.`} />

  {/* 9 · Brand separation (Rego Park especially) */}
  {page.separation && (
    <section class="border-t border-line bg-porch" aria-label="About our name">
      <div class="container-x flex items-start gap-3 py-8">
        <Icon name="pin" size={22} class="mt-0.5 flex-none text-harbor" />
        <p class="text-slate">{SITE.independentLine} Our Rego Park clinic is at 63-36 99th Street. We are not affiliated with other counseling centers with similar names.</p>
      </div>
    </section>
  )}

  {/* 10 · Final band */}
  <FinalCta title={page.finalH2} text={`${fullAddress(c)} · ${c.phone}`} />
</Base>
