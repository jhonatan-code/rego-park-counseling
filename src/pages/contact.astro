---
// Contact (About Section Content brief, §3). Banner: H1 + subhead + big phone button, form on the right
// (same four-field form as every page, per the user's form decision). Clinics as two detailed cards side by
// side + a slim Yonkers row + map, other ways to reach us, crisis panel (required), brand-separation line.
// Every address and phone must match the Google Business Profiles and the footer character for character.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { SITE, CLINICS, fullAddress } from '../data/site.js';
import MobileFormSection from '../components/MobileFormSection.astro';
import ClinicMapPanel from '../components/ClinicMapPanel.astro';

const open = CLINICS.filter((c) => c.status === 'open');
const yonkers = CLINICS.find((c) => c.id === 'yonkers')!;
// [confirm] transit and parking per clinic
const NEAR: Record<string, string> = {
  // BRACKETS-FILL-PLAN 1.3–1.4: no bus names, walk/ride times or parking until confirmed
  'rego-park': 'Near the 63rd Drive–Rego Park station (M and R trains). Several bus lines stop nearby.',
  'fresh-meadows': 'Close to Flushing. Use the map for directions.',
};

const schema = [
  {
    '@type': 'ContactPage',
    '@id': `${SITE.url}/contact/#webpage`,
    url: `${SITE.url}/contact/`,
    name: 'Contact Rego Park Counseling',
    about: { '@id': `${SITE.url}/#organization` },
    mentions: open.map((c) => ({ '@id': `${SITE.url}${c.href}#clinic` })),
  },
];
---
<Base
  title="Contact Rego Park Counseling | Rego Park & Fresh Meadows, NY"
  description="Call (718) 459-2558 or request a callback. Visit our clinics at 63-36 99th Street, Rego Park, and in Fresh Meadows, Queens. Most Medicaid plans accepted."
  breadcrumbs={[{ name: 'Contact', href: '/contact/' }]}
  schema={schema}
>
  <PageHero
    title="Contact Rego Park Counseling"
    sub="Call us or leave your number. We’ll call you back as soon as possible."
    eyebrow="Contact us"
    crumbs={[{ name: 'Contact', href: '/contact/' }]}
    formId="cb-contact"
    bigPhone
  />

  {/* Visit our clinics: map panel (Google Maps) + Yonkers */}
  <ClinicMapPanel reviews={false} id="visit" eyebrow="Our clinics" title="Visit Our Clinics" yonkers />

  {/* Other ways to reach us + crisis */}
  <section class="section-y bg-white" aria-labelledby="other-title">
    <div class="container-x grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-12">
      <div>
        <h2 id="other-title">Other Ways to Reach Us</h2>
        <ul class="mt-8 grid gap-4 sm:grid-cols-3">
          <li class="rounded-[var(--radius-card)] bg-porch p-5">
            <span class="icon-dot bg-white"><Icon name="clipboard" /></span>
            <h3 class="mt-4 text-lg">Fax</h3>
            <p class="mt-1 font-bold text-ink">{SITE.fax}</p>
            <p class="text-base text-slate">For referrals and records.</p>
          </li>
          <li class="rounded-[var(--radius-card)] bg-porch p-5">
            <span class="icon-dot bg-white"><Icon name="scale" /></span>
            <h3 class="mt-4 text-lg">Referrals</h3>
            <p class="mt-1 text-base text-slate">Referrals: fax {SITE.fax} or call <a href={SITE.phoneHref} class="font-bold text-harbor hover:underline" data-cta="call" data-location="contact-referrals">{SITE.phone}</a>.</p>
          </li>
          <li class="rounded-[var(--radius-card)] bg-porch p-5">
            <span class="icon-dot bg-white"><Icon name="telehealth" /></span>
            <h3 class="mt-4 text-lg">Telehealth</h3>
            <p class="mt-1 text-base text-slate">Ask about telehealth when you call.</p>
            <a href="/programs/telehealth/" class="mt-2 inline-flex items-center gap-1 text-base font-bold text-harbor hover:underline">How it works <Icon name="arrow-right" size={16} /></a>
          </li>
        </ul>
      </div>

      {/* Crisis line: required on a mental health contact page. Calm, not alarm red (brand manual). */}
      <aside class="rounded-[var(--radius-panel)] border-l-[6px] border-harbor bg-sky-wash p-6 lg:p-8" aria-labelledby="crisis-title">
        <h3 id="crisis-title" class="flex items-center gap-2 text-2xl"><Icon name="faq" size={26} /> In Crisis?</h3>
        <p class="mt-3">If you or someone you know is in danger, call <a href="tel:911" class="font-bold text-harbor underline">911</a>. For mental health or substance use crises, call or text <a href="tel:988" class="font-bold text-harbor underline">988</a>, the Suicide &amp; Crisis Lifeline, available 24/7.</p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="tel:988" class="btn-neutral">Call 988</a>
          <a href="sms:988" class="btn-secondary">Text 988</a>
        </div>
        <p class="mt-5 text-base text-slate">Rego Park Counseling is not an emergency service.</p>
      </aside>
    </div>
  </section>

  {/* Mobile: the form (not in the banner below 1024px) */}
  <MobileFormSection />

  {/* Brand separation line */}
  <section class="border-t border-line bg-porch" aria-label="About our name">
    <div class="container-x flex items-start gap-3 py-8">
      <Icon name="pin" size={22} class="mt-0.5 flex-none text-harbor" />
      <p class="text-slate">Rego Park Counseling is an independent clinic. If you are looking for another counseling center on Queens Boulevard, please contact them directly.</p>
    </div>
  </section>
</Base>
