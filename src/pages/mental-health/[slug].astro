---
// Condition pages (Mental Health Pages Content brief). One Service template, same 10 sections on every page so
// users learn the pattern and Google sees a consistent cluster:
// 1 hero (form right) · 2 signs · 3 how we help · 4 what to expect · 5 where (+telehealth) · 6 insurance line ·
// 7 related services (+posts) · 8 FAQ · 9 crisis note · 10 final band.
// Schema: MedicalWebPage (about → MedicalCondition, audience → Patient, provider → org) + FAQPage + BreadcrumbList.
// reviewedBy/lastReviewed join once the clinical reviewer is named.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import PageHero from '../../components/PageHero.astro';
import LocationCards from '../../components/LocationCards.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import InsuranceLine from '../../components/InsuranceLine.astro';
import FaqList from '../../components/FaqList.astro';
import CrisisNote from '../../components/CrisisNote.astro';
import FinalCta from '../../components/FinalCta.astro';
import { SITE } from '../../data/site.js';
import { CONDITIONS, clean } from '../../data/mental-health.js';

export function getStaticPaths() {
  return CONDITIONS.map((c) => ({ params: { slug: c.slug }, props: { page: c } }));
}
const { page } = Astro.props;
const url = `${SITE.url}/mental-health/${page.slug}/`;
const crumbs = [{ name: 'Mental Health', href: '/mental-health/' }, { name: page.crumb, href: `/mental-health/${page.slug}/` }];
const faqs = page.faqs.filter((f: any) => !f.gate);
const schema = [
  {
    '@type': 'MedicalWebPage',
    '@id': `${url}#webpage`,
    url,
    name: page.h1,
    about: { '@type': 'MedicalCondition', name: page.condition },
    audience: { '@type': 'Patient' },
    provider: { '@id': `${SITE.url}/#organization` },
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'FAQPage',
    '@id': `${url}#faq`,
    mainEntity: faqs.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: clean(f.a) } })),
  },
];
const help = page.help;
---
<Base title={page.title} description={page.description} breadcrumbs={crumbs} schema={schema}>
  {/* 1 · Hero */}
  <PageHero
    title={page.h1}
    sub={page.sub}
    crumbs={crumbs}
    formId={`cb-${page.slug}`}
    trust={['OMH-licensed clinic', 'Most Medicaid plans', 'In person or telehealth']}
  />

  {/* 2 · Signs (or intro, for schizophrenia) */}
  {page.signs ? (
    <section class="section-y" aria-labelledby="signs-title">
      <div class="container-x grid items-start gap-10 lg:grid-cols-[1fr_1.25fr] lg:gap-16">
        <div class="lg:sticky lg:top-28">
          <span class="icon-dot size-14"><Icon name={page.icon} size={28} /></span>
          <h2 id="signs-title" class="mt-5">{page.signs.h2}</h2>
          <p class="lead mt-4">{page.signs.intro}</p>
          {page.signs.outro && <p class="measure mt-4 text-slate">{page.signs.outro}</p>}
        </div>
        <div>
          <ul class="grid gap-3">
            {page.signs.items.map((s: string) => (
              <li class="flex items-start gap-4 rounded-[var(--radius-card)] border border-line bg-white p-4 lg:p-5">
                <span class="mt-0.5 inline-flex size-7 flex-none items-center justify-center rounded-full bg-sky text-harbor"><Icon name="check" size={16} strokeWidth={3} /></span>
                <span class="text-lg">{s}</span>
              </li>
            ))}
          </ul>
          {page.signs.alert && (
            <p class="mt-4 flex items-start gap-3 rounded-[var(--radius-card)] border-l-[5px] border-harbor bg-sky-wash p-4 font-bold text-harbor">
              <Icon name="phone" size={20} class="mt-0.5 flex-none" />
              <span>{page.signs.alert.split('988')[0]}<a href="tel:988" class="underline">988</a>{page.signs.alert.split('988')[1]}</span>
            </p>
          )}
          <p class="mt-6 text-slate">Sound familiar? <a href={SITE.phoneHref} class="text-link" data-cta="call" data-location="signs">Call {SITE.phone}</a> and talk it through with us.</p>
        </div>
      </div>
    </section>
  ) : (
    <section class="section-y" aria-labelledby="intro-title">
      <div class="container-x grid items-center gap-10 lg:grid-cols-[auto_1fr] lg:gap-14">
        <span class="icon-dot size-20"><Icon name={page.icon} size={40} /></span>
        <div>
          <h2 id="intro-title">{page.intro.h2}</h2>
          <p class="lead measure mt-4">{page.intro.text}</p>
        </div>
      </div>
    </section>
  )}

  {/* 3 · How we help */}
  <section class="section-y bg-white" aria-labelledby="help-title">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="eyebrow">Our approach</p>
        <h2 id="help-title" class="mt-3">{help.h2}</h2>
      </div>
      <ol class:list={['mt-10 grid gap-6', help.cards.length === 4 ? 'md:grid-cols-2 lg:grid-cols-4' : 'md:grid-cols-3']}>
        {help.cards.map((c: any, i: number) => (
          <li class="relative flex flex-col rounded-[var(--radius-panel)] border border-line bg-porch p-6 lg:p-7">
            <span aria-hidden="true" class="absolute right-6 top-5 font-display text-4xl font-extrabold text-sky">0{i + 1}</span>
            <span class="icon-dot bg-white"><Icon name={c.icon} /></span>
            <h3 class="mt-5 pr-10 text-xl">{c.title}</h3>
            <p class="mt-2 text-slate">{c.text}</p>
            {c.link && <a href={c.link.href} class="text-link mt-auto inline-flex items-center gap-1.5 pt-4">{c.link.label} <Icon name="arrow-right" size={18} /></a>}
          </li>
        ))}
      </ol>
      {help.line && (
        <a href={help.line.href} class="group mt-6 flex flex-col gap-2 rounded-[var(--radius-panel)] bg-sky-wash p-5 sm:flex-row sm:items-center sm:justify-between lg:px-7">
          <span class="flex items-center gap-3 text-lg"><Icon name="link" size={22} class="flex-none text-harbor" />{help.line.text}</span>
          <span class="inline-flex flex-none items-center gap-1.5 font-bold text-harbor group-hover:underline">{help.line.label} <Icon name="arrow-right" size={18} /></span>
        </a>
      )}
      {help.med && <p class="mt-6 flex items-start gap-3 text-slate"><Icon name="faq" size={20} class="mt-0.5 flex-none text-harbor" />{help.med}</p>}
    </div>
  </section>

  {/* Court-referred block: rendered only once the brief's gate is confirmed */}
  {page.court && !page.court.gate && (
    <section class="section-y pt-0" aria-labelledby="court-title">
      <div class="container-x">
        <div class="flex flex-col gap-4 rounded-[var(--radius-panel)] border-2 border-sky bg-white p-6 sm:flex-row sm:items-center lg:p-8">
          <span class="icon-dot"><Icon name="scale" /></span>
          <div class="flex-1">
            <h2 id="court-title" class="text-2xl">{page.court.h2}</h2>
            <p class="mt-2">{page.court.text}</p>
          </div>
          <a href={page.court.href} class="btn-secondary flex-none">{page.court.label}</a>
        </div>
      </div>
    </section>
  )}

  {/* 4 · What to expect */}
  <section class="section-y bg-sand" aria-labelledby="expect-title">
    <div class="container-x">
      <h2 id="expect-title" class="text-center">What to Expect</h2>
      <ol class="relative mt-12 grid gap-8 md:grid-cols-3 md:gap-6">
        <li aria-hidden="true" class="absolute left-[16.6%] right-[16.6%] top-7 hidden border-t-2 border-dashed border-harbor/40 md:block"></li>
        {page.expect.map((s: any, i: number) => (
          <li class="relative flex gap-4 md:flex-col md:items-center md:text-center">
            <span class="relative inline-flex size-14 flex-none items-center justify-center rounded-full bg-harbor font-display text-2xl font-extrabold text-white ring-8 ring-sand">{i + 1}</span>
            <div>
              <h3 class="md:mt-4">{s.title.replace(/\.$/, '')}</h3>
              <p class="mt-2 text-slate md:mx-auto md:max-w-[32ch]">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* 5 · Where to get care */}
  <LocationCards title={page.whereH2} telehealth={page.telehealth} />

  {/* 6 · Insurance line */}
  <InsuranceLine extra={page.insuranceExtra} />

  {/* 7 · Related services + posts */}
  <RelatedServices related={page.related} posts={page.posts} />

  {/* 8 · FAQ */}
  <FaqList title={page.faqH2} faqs={page.faqs} />

  {/* 9 · Crisis note */}
  <CrisisNote veterans={page.veterans} />

  {/* 10 · Final band */}
  <FinalCta title={page.finalH2} text="A licensed counselor near home. We’ll check your Medicaid plan on the call." />
</Base>
