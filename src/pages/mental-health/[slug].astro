---
// Mental Health condition pages: data in src/data/mental-health.js, layout in components/ServiceTemplate.astro.
import ServiceTemplate from '../../components/ServiceTemplate.astro';
import { CONDITIONS } from '../../data/mental-health.js';

export function getStaticPaths() {
  return CONDITIONS.map((c) => ({ params: { slug: c.slug }, props: { page: c } }));
}
const { page } = Astro.props;
---
<ServiceTemplate
  page={page}
  root={{ name: 'Mental Health', href: '/mental-health/' }}
  trust={['OMH-licensed clinic', 'Most Medicaid plans', 'In person or telehealth']}
  finalText="A licensed counselor near home. We’ll check your Medicaid plan on the call."
/>
