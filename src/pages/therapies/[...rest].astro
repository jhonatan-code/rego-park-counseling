---
// /therapies/ hub + child pages: data in src/data/programs.js, layout in components/BlockPage.astro.
import BlockPage from '../../components/BlockPage.astro';
import { PAGES } from '../../data/programs.js';

export function getStaticPaths() {
  return PAGES.filter((p) => p.path.startsWith('/therapies/')).map((p) => {
    const rest = p.path.replace('/therapies/', '').replace(/\/$/, '');
    return { params: { rest: rest || undefined }, props: { page: p } };
  });
}
const { page } = Astro.props;
---
<BlockPage page={page} />
