---
// 404 (Remaining Pages brief; "not-found.tsx" there = this page in Astro). Vercel serves it with HTTP 404 for any
// unknown path. Gone URLs (Redirect Map 410 rows) never reach it: the middleware answers them with a 410.
// Tracking: dataLayer page_not_found with the requested path (no query string), so broken links found after launch
// can go into the redirect map.
import Base from '../layouts/Base.astro';
// Rendered on demand (not prerendered) so every unknown path runs src/middleware.ts first: a path in the Redirect Map's
// 410 list gets the 410, anything else this page with a 404. When this page was static, Astro's catch-all route sent
// unknown paths straight to /404.html before the vercel.json rewrites to /api/gone/ could run, so all 133 gone URLs
// answered 404 (found by the redirect-map crawl, 2026-10-01).
export const prerender = false;
import Icon from '../components/Icon.astro';
import NearbyRing from '../components/NearbyRing.astro';
import { SITE } from '../data/site.js';

const LINKS = [
  { href: '/mental-health/', label: 'Mental Health Counseling', icon: 'brain' },
  { href: '/substance-use/', label: 'Outpatient Substance Use Treatment', icon: 'sprout' },
  { href: '/evaluations/', label: 'Substance Abuse and DWI Evaluations', icon: 'clipboard' },
  { href: '/locations/', label: 'Our Clinics', icon: 'pin' },
  { href: '/insurance/', label: 'Insurance and Medicaid', icon: 'medicaid' },
  { href: '/blog/', label: 'Blog', icon: 'book' },
];
---
<Base title="Page Not Found | Rego Park Counseling" description="The page may have moved or no longer exists." noindex>
  <section class="relative overflow-hidden bg-sky-wash" aria-labelledby="page-title">
    <NearbyRing class="pointer-events-none absolute -right-32 -top-32 hidden size-[460px] lg:block" />
    <div class="container-x relative py-14 lg:py-20">
      <p class="eyebrow">Error 404</p>
      <h1 id="page-title" class="mt-3">We Can’t Find That Page</h1>
      <p class="lead measure mt-4">The page may have moved or no longer exists. Here are the places people usually look for:</p>
    </div>
  </section>

  <section class="section-y" aria-label="Popular pages">
    <div class="container-x">
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {LINKS.map((l) => (
          <li>
            <a href={l.href} class="flex min-h-20 items-center gap-4 rounded-[var(--radius-card)] border border-line bg-white p-5 font-display text-lg font-extrabold text-harbor transition-shadow duration-200 hover:shadow-[0_8px_24px_rgba(7,65,91,0.12)]">
              <span class="icon-dot bg-sky-wash"><Icon name={l.icon} /></span>
              <span class="flex-1">{l.label}</span>
              <Icon name="arrow-right" size={20} class="flex-none" />
            </a>
          </li>
        ))}
      </ul>

      <form action="/blog/" method="get" role="search" class="mt-10 max-w-xl">
        <label for="nf-search" class="mb-2 block font-display text-lg font-extrabold text-harbor">Search our articles</label>
        <div class="flex gap-2">
          <div class="relative flex-1">
            <Icon name="search" size={20} class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-harbor" />
            <input id="nf-search" name="q" type="search" autocomplete="off" maxlength="80" placeholder="e.g. anxiety, alcohol, Medicaid" class="min-h-12 w-full rounded-full border border-sky bg-white py-3 pl-12 pr-5 text-base text-ink placeholder:text-slate focus:border-harbor" />
          </div>
          <button type="submit" class="btn-secondary !min-h-12">Search</button>
        </div>
      </form>
    </div>
  </section>

  <section class="bg-sand" aria-labelledby="help-now">
    <div class="container-x flex flex-col items-start gap-6 py-12 lg:flex-row lg:items-center lg:justify-between lg:py-14">
      <h2 id="help-now">Need help now?</h2>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href={SITE.phoneHref} class="btn-call" data-cta="call" data-location="404"><Icon name="phone" size={20} /> Call {SITE.phone}</a>
        <a href="/contact/" class="btn-secondary" data-open-callback data-location="404">Request a Callback</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const w = window as any;
  (w.dataLayer = w.dataLayer || []).push({ event: 'page_not_found', page_path: location.pathname.slice(0, 200) });
</script>
